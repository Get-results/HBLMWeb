# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Visuels de travail (placeholders, exemples Instagram, photos du club) : non
# versionnés. Les photos attendent la confirmation du droit à l'image avec le
# bureau, et le dépôt GitHub est public — un ajout resterait dans l'historique
# git même après suppression. Voir EXPERIENCE.md > Contraintes de contenu.
# Les vrais assets de production auront leur propre emplacement, à définir.
/asset_placeholder/
/assets/

# Garde-fou : captures et images déposées à la racine. Elles n'y ont jamais leur
# place — les documents source du club vivent dans /assets/, les visuels de
# travail dans /asset_placeholder/. La règle existe parce que le cas s'est
# produit : un `git add -A` a ramassé cinq captures qui traînaient ici, dont un
# organigramme avec les visages et les noms du conseil d'administration.
/*.png
/*.jpg
/*.jpeg
/*.webp

# Documentation de l'API des matchs, fournie par le porteur du projet.
# NON VERSIONNÉE, et c'est délibéré : FRONTEND_INTEGRATION.md documente la route
# d'authentification avec des identifiants par défaut en clair
# (`{ "username": "admin", "password": "admin" }`). Le dépôt est public — les
# publier reviendrait à annoncer comment s'authentifier sur l'API.
# À reverser dans le dépôt une fois ce passage retiré ou les identifiants
# changés : `src/content.config.ts` y renvoie, et un clone neuf ne l'a pas.
/docs/

# BMAD : installation, outputs et skills installées — outillage local, non versionné
/_bmad/
/_bmad-output/
/.claude/skills/bmad-*/

# Réglages Claude Code personnels à cette machine, qui n'ont pas à partir dans un
# commit. Aucun réglage n'est versionné ici : le garde-fou `git add` vit dans
# ~/.claude, hors du dépôt — versionné, il ne s'appliquerait qu'aux branches qui
# le portent et disparaîtrait au premier `git switch`. Voir CLAUDE.md § 2.
/.claude/settings.local.json

# Verrou local du planificateur Claude Code
/.claude/scheduled_tasks.lock

# Worktrees créés par les agents (dépôts git imbriqués, jamais à versionner)
.claude/worktrees/

# Gabarit de travail rempli avec le bureau : contient des données personnelles
# (noms, téléphone, adresse). Ne doit jamais partir dans un commit.
MENTIONS-LEGALES-A-REMPLIR.md

# Données de matchs : produites par scripts/fetch-matches.mjs avant chaque
# build, remplacées intégralement à chaque fois (AD-4). Volatiles par nature,
# elles n'ont rien à faire dans l'historique.
src/content/matches/matches.json
