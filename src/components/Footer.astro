---
/*
 * Footer du site — monté une seule fois par BaseLayout.
 * Contact, plan du site, mention légale.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-brand">
			<p class="footer-name">Handball Lunel-Marsillargues</p>
			<p class="footer-contact">
				<a href={`${base}/inscription#contact-form`}>Nous contacter</a>
			</p>
		</div>

		<nav class="footer-nav" aria-label="Plan du site">
			<ul class="footer-links">
				<li><a href={`${base}/`}>Accueil</a></li>
				<li><a href={`${base}/planning`}>Planning</a></li>
				<li><a href={`${base}/inscription`}>Inscription</a></li>
				<li><a href={`${base}/stages`}>Stages</a></li>
				<li><a href={`${base}/le-club`}>Le club</a></li>
				<li><a href={`${base}/matchs`}>Matchs</a></li>
			</ul>
		</nav>
	</div>

	<p class="footer-legal">© 2026 Handball Lunel-Marsillargues</p>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		padding: var(--space-section-y) 5vw var(--space-8);
		background-color: var(--color-bg);
	}

	.footer-inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.footer-name {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 18px;
		color: var(--color-text);
	}

	.footer-contact {
		margin: 0;
	}

	.footer-contact a {
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.footer-contact a:hover {
		color: var(--color-accent);
	}

	.footer-nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4) var(--space-6);
	}

	.footer-nav a {
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 14px;
	}

	.footer-nav a:hover {
		color: var(--color-text);
	}

	.footer-legal {
		margin: var(--space-8) 0 0;
		font-size: var(--size-eyebrow);
		color: var(--color-text-muted);
		letter-spacing: var(--tracking-eyebrow);
		text-transform: uppercase;
	}

	@media (min-width: 640px) {
		.footer-inner {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-start;
		}
	}
</style>
