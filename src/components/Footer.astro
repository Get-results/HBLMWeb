---
/*
 * Footer du site — monté une seule fois par BaseLayout.
 * Contact, plan du site, mention légale, version.
 */
import { version } from '../../package.json';

/* Le numéro de version vient de `package.json` et de nulle part ailleurs : une
   version écrite en dur dans un composant devient fausse au premier oubli. Elle
   est lue au build, donc la page reste statique — rien n'est calculé chez le
   visiteur. Pour la faire évoluer : `npm version patch|minor|major`, ou éditer le
   champ `version`. Elle sert à savoir, depuis un téléphone et sans accès au
   dépôt, quelle mise en ligne on a sous les yeux. */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-brand">
			<p class="footer-name">Handball Lunel-Marsillargues</p>
			<p class="footer-contact">
				<a href={`${base}/inscription#contact-form`}>Nous contacter</a>
			</p>
		</div>

		<nav class="footer-nav" aria-label="Plan du site">
			<ul class="footer-links">
				<li><a href={`${base}/`}>Accueil</a></li>
				<li><a href={`${base}/planning`}>Planning</a></li>
				<li><a href={`${base}/inscription`}>Inscription</a></li>
				<li><a href={`${base}/stages`}>Stages</a></li>
				<li><a href={`${base}/le-club`}>Le club</a></li>
				<li><a href={`${base}/matchs`}>Matchs</a></li>
			</ul>
		</nav>
	</div>

	{/* Les mentions légales doivent rester accessibles depuis chaque page (LCEN) :
	    leur place est donc ici, dans le footer monté par BaseLayout, et non dans
	    la navigation principale. */}
	<p class="footer-legal">
		<span>© 2026 Handball Lunel-Marsillargues</span>
		<a href={`${base}/mentions-legales`}>Mentions légales</a>
		<span class="footer-version">v{version}</span>
	</p>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		padding: var(--space-section-y) 5vw var(--space-8);
		background-color: var(--color-bg);
	}

	.footer-inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.footer-name {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 18px;
		color: var(--color-text);
	}

	.footer-contact {
		margin: 0;
	}

	.footer-contact a {
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.footer-contact a:hover {
		color: var(--color-accent);
	}

	.footer-nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4) var(--space-6);
	}

	.footer-nav a {
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 14px;
	}

	.footer-nav a:hover {
		color: var(--color-text);
	}

	.footer-legal {
		margin: var(--space-8) 0 0;
		font-size: var(--size-eyebrow);
		color: var(--color-text-muted);
		letter-spacing: var(--tracking-eyebrow);
		text-transform: uppercase;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
	}

	.footer-legal a {
		color: var(--color-text-muted);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.footer-legal a:hover {
		color: var(--color-text);
	}

	/* Discret par construction : il hérite de la couleur en retrait et de la taille
	   « eyebrow » de la ligne légale, et passe à droite dès qu'il y a la place. Il
	   ne doit jamais concurrencer les mentions légales, seule information
	   obligatoire de cette ligne. Chiffres tabulaires pour qu'il ne fasse pas
	   danser la ligne quand la version s'allonge. */
	.footer-version {
		font-variant-numeric: tabular-nums;
	}

	@media (min-width: 640px) {
		.footer-inner {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-start;
		}

		.footer-version {
			margin-left: auto;
		}
	}
</style>
