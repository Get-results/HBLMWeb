---
/* Affichage des informations de catégorie (créneaux, tarif, essai, référent)
   sur les pages statiques — Inscription et Faire un essai.

   Ce composant n'est PAS l'île « Trouver ma catégorie » (Story 2.3, AD-7) : il
   ne résout aucun profil, il liste. La résolution restera l'affaire du seul
   `CategoryFinder`, pour qu'il n'existe jamais deux calculs de catégorie.

   Invariant tenu ici : il ne lit la collection qu'à travers
   `getCategoriesPubliees()`, qui ne rend que les fiches validées par le bureau.
   Tant qu'il n'y en a aucune, on affiche un état « en cours de préparation »
   explicite plutôt qu'un tableau de valeurs inventées — le site est en ligne, et
   un horaire faux fait se déplacer un parent pour rien.

   Mise en page — reprise des idiomes déjà éprouvés ailleurs sur le site :
   la carte par catégorie et l'alignement jour / horaire / gymnase viennent de
   `planning.astro` ; le bloc à gauche qui sert de point d'accroche au regard
   vient de `CarteMatch.astro`, où c'est la date.

   Ce qui a changé et pourquoi. La version précédente empilait les douze
   catégories dans une seule `<dl>` : douze titres et trente lignes grises de
   poids voisin, sans repère. Surtout, sur une section intitulée « Tarifs par
   catégorie », le tarif était la DERNIÈRE ligne de chaque bloc, en gris atténué
   — l'information annoncée par le titre était la moins visible de la page. Elle
   est désormais portée par un bloc dédié, lu avant le reste. */
import {
	getCategoriesPubliees,
	formaterJour,
	formaterHeures,
	formaterTarif,
	formaterAnneesNaissance,
} from '../lib/categories';

interface Props {
	/* Change le titre et la phrase d'accroche, pas les données affichées :
	   une catégorie montre les mêmes informations où qu'on la consulte. */
	mode?: 'tarifs' | 'creneaux';
}

const { mode = 'tarifs' } = Astro.props;

const titre = mode === 'tarifs' ? 'Tarifs par catégorie' : 'Créneaux et catégories';
const accroche =
	mode === 'tarifs'
		? 'Le tarif de licence dépend de la catégorie.'
		: "Chaque catégorie a ses créneaux et sa disponibilité d'essai.";

const categories = await getCategoriesPubliees();
const saisons = [...new Set(categories.map(({ data }) => data.season).filter(Boolean))];
---

{
	categories.length === 0 ? (
		<div class="card accent-card">
			<h2>{titre}</h2>
			<p class="placeholder">Informations en cours de préparation.</p>
			<p>
				{accroche} Nous publierons les catégories du club dès que le bureau aura validé les
				créneaux, les tarifs et les référents. Nous préférons ne rien afficher plutôt
				qu'afficher une information dont nous ne sommes pas sûrs.
			</p>
			<p>
				D'ici là, écrivez-nous&nbsp;: nous vous indiquons directement le créneau et le tarif qui
				vous concernent. <a href="#contact-form">Aller au formulaire de contact</a>.
			</p>
		</div>
	) : (
		<div class="card">
			<h2>{titre}</h2>
			<p class="accroche">
				{accroche}
				{saisons.length === 1 && <> Informations de la saison {saisons[0]}.</>}
			</p>

			{/* `id={categorie-<id>}` : ancre stable vers une catégorie précise, qui ne
			    dépend pas du libellé — celui-ci peut changer d'une saison à l'autre. */}
			<ul class="categories">
				{categories.map(({ id, data }) => {
					const annees = formaterAnneesNaissance(data);
					return (
						<li class="categorie" id={`categorie-${id}`}>
							<div class="entete">
								<div class="identite">
									<h3>{data.label}</h3>
									{/* L'année de naissance répond à la question que le visiteur se
									    pose devant la liste — « laquelle est celle de mon enfant ? ».
									    Elle est en données depuis la Story 2.1 mais n'était affichée
									    nulle part hors du parcours « Trouver ma catégorie ». */}
									{annees && <p class="annees">{annees}</p>}
								</div>

								{/* Le tarif en bloc, à la manière du bloc date de `CarteMatch` :
								    un point d'accroche de position fixe, que le regard trouve sans
								    lire, quelle que soit la longueur du libellé de catégorie.
								    Non-null assumé : le schéma refuse au build une fiche confirmée
								    sans tarif. */}
								<p class="tarif">
									<span class="tarif-montant">{formaterTarif(data.licenseFee!)}</span>
									<span class="tarif-legende">licence</span>
								</p>
							</div>

							{/* Pas de libellé « Créneaux » au-dessus de cette liste : « Mardi
							    17h30 – 19h00 — Gymnase Arnassan » ne peut être qu'un créneau, le
							    mot ne fait que répéter ce que la ligne dit déjà. C'est aussi
							    pourquoi la liste sort de la `<dl>` — un terme de définition qui
							    n'apprend rien n'a pas à exister pour la forme, y compris pour une
							    synthèse vocale qui le lirait sur chacune des douze fiches.

							    Jour, horaire et gymnase en colonnes plutôt qu'en une seule chaîne
							    (`formaterCreneau`) : alignés, trois créneaux se comparent d'un
							    coup d'œil. La colonne des heures est en chiffres tabulaires pour
							    que les deux-points s'alignent. */}
							<ul class="creneaux">
								{data.trainingSlots.map((creneau) => (
									<li class="creneau">
										<span class="creneau-jour">{formaterJour(creneau)}</span>
										<span class="creneau-heure">{formaterHeures(creneau)}</span>
										<span class="creneau-lieu">{creneau.venue}</span>
									</li>
								))}
							</ul>

							{/* La `<dl>` ne subsiste que pour les informations dont le libellé
							    apprend vraiment quelque chose, et elle disparaît quand aucune
							    n'est renseignée — le cas de toutes les catégories aujourd'hui. */}
							{(data.trialAvailable !== null || data.contact) && (
								<dl>
									{/* `trialAvailable: null` (non renseigné) n'affiche pas de ligne « essai » :
									    un « indisponible » par défaut serait un renseignement faux (FR-3). */}
									{data.trialAvailable !== null && (
										<>
											<dt>Séance d'essai</dt>
											<dd>{data.trialAvailable ? 'Possible' : 'Pas de créneau d’essai actuellement'}</dd>
										</>
									)}

									{data.contact && (
										<>
											<dt>Référent</dt>
											<dd>
												{data.contact.name}
												{data.contact.email && (
													<>
														{' — '}
														<a href={`mailto:${data.contact.email}`}>
															Écrire à {data.contact.name}
														</a>
													</>
												)}
												{data.contact.phone && <> — {data.contact.phone}</>}
											</dd>
										</>
									)}
								</dl>
							)}
						</li>
					);
				})}
			</ul>
		</div>
	)
}

<style>
	.accroche {
		color: var(--color-text-muted);
	}

	/* Une carte par catégorie plutôt qu'un filet de séparation : chaque fiche
	   devient un objet distinct, et la grille peut en poser deux de front dès que
	   la largeur le permet — douze blocs en colonne unique faisaient une page
	   qu'on faisait défiler sans la lire. */
	.categories {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-3);
	}

	/* Conteneur de requête, et non des `@media` : ce qui décide de la mise en
	   page interne d'une fiche est la largeur de LA CARTE, pas celle de la
	   fenêtre. Dès que la grille passe à deux colonnes, une carte de 1300px de
	   fenêtre n'en fait plus que 360 — des points de rupture sur la fenêtre y
	   imposaient des colonnes qui ne rentraient pas, et chaque créneau se
	   cassait sur trois lignes. */
	.categorie {
		container-type: inline-size;
		padding: var(--space-4) var(--space-6) var(--space-6);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background-color: var(--color-surface);
	}

	/* Le filet de séparation en accent. C'est la seule couleur de la fiche, et
	   elle a un rôle : marquer la coupure entre l'identité de la catégorie
	   (libellé + années de naissance) et son détail pratique (créneaux). Répété
	   d'une carte à l'autre, il donne à la section la pulsation qui lui manquait
	   quand tout était gris.

	   2px et non un aplat : DESIGN.md réserve l'accent aux badges, aux CTA et aux
	   éléments décoratifs, et interdit explicitement les grandes surfaces. Un
	   filet reste du trait. Et il ne porte aucun texte, donc la règle du
	   « texte sur accent toujours en #222220 » ne s'applique pas ici. */
	.entete {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: var(--space-4);
		padding-bottom: var(--space-3);
		border-bottom: 2px solid var(--color-accent);
	}

	.identite {
		min-width: 0;
	}

	.categorie h3 {
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 1.125rem;
		margin: 0;
		color: var(--color-text);
	}

	.annees {
		margin: var(--space-1) 0 0;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	/* Le tarif : deux lignes courtes, alignées à droite, à la manière du bloc
	   date d'une carte de match. Le montant porte la graisse des titres — c'est
	   l'information que la section annonce. */
	.tarif {
		flex: none;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--space-1);
		margin: 0;
		text-align: right;
	}

	.tarif-montant {
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 1.5rem;
		line-height: 1.1;
		color: var(--color-text);
		font-variant-numeric: tabular-nums;
	}

	.tarif-legende {
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: var(--tracking-eyebrow);
		color: var(--color-text-muted);
	}

	dl {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-1);
		/* Marge haute : la `<dl>` suit maintenant la liste des créneaux au lieu
		   de la contenir. */
		margin: var(--space-4) 0 0;
	}

	dt {
		font-weight: var(--weight-body-strong);
		color: var(--color-text);
	}

	dd {
		margin: 0 0 var(--space-3) 0;
		color: var(--color-text-muted);
	}

	dd:last-of-type {
		margin-bottom: 0;
	}

	.creneaux {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-2);
	}

	/* Carte étroite : le jour et l'horaire tiennent la première ligne — c'est le
	   couple qu'on compare d'un créneau à l'autre — et le gymnase passe dessous
	   plutôt que de casser l'alignement. */
	.creneau {
		display: grid;
		/* Colonne de jour de largeur FIXE, et non `auto` : chaque créneau étant sa
		   propre grille, une colonne dimensionnée sur son contenu se calerait sur
		   « Mercredi » dans un créneau et sur « Samedi » dans le suivant — les
		   horaires ne s'aligneraient plus d'une ligne à l'autre, ce qui est
		   précisément ce qu'on vient les chercher ici. */
		grid-template-columns: 5.5em 1fr;
		align-items: baseline;
		gap: var(--space-1) var(--space-3);
	}

	.creneau-jour {
		font-weight: var(--weight-body-strong);
		color: var(--color-text);
	}

	.creneau-heure {
		font-variant-numeric: tabular-nums;
		color: var(--color-text);
	}

	.creneau-lieu {
		grid-column: 1 / -1;
		color: var(--color-text-muted);
	}

	/* Mobile-first : on élargit quand la CARTE en a la place. 30rem est la
	   largeur à partir de laquelle le gymnase tient sur la ligne du créneau
	   sans la faire déborder. */
	@container (min-width: 30rem) {
		.creneau {
			display: flex;
			flex-wrap: wrap;
		}

		.creneau-jour {
			min-width: 5.5em;
		}

		.creneau-heure {
			min-width: 8.5em;
		}

		.creneau-lieu {
			grid-column: auto;
		}
	}

	/* Le libellé « Créneaux » ne passe à gauche que si la carte reste lisible
	   une fois cette colonne prélevée. */
	@container (min-width: 34rem) {
		dl {
			grid-template-columns: minmax(7rem, auto) 1fr;
			column-gap: var(--space-4);
		}
	}

	/* Au-delà de 900px, deux fiches de front : la colonne unique laissait la
	   moitié droite de l'écran vide sur douze cartes. */
	@media (min-width: 900px) {
		.categories {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-card-gap);
		}
	}
</style>
