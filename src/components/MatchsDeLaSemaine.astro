---
/* Bandeau « Cette semaine » de la page d'accueil.

   Il répond à une seule question — « qui joue dans les jours qui viennent ? » —
   et renvoie vers /matchs pour tout le reste : les résultats, les rencontres
   plus lointaines, le filtre par équipe.

   Une LISTE et non des cartes. La première version montrait quatre cartes de
   115 px et masquait le reste derrière « + N autres rencontres » : sur un
   week-end de championnat chargé, la moitié du club ne se voyait pas sur la
   section qui prétend l'annoncer. Le problème n'était pas la place mais le
   format — un gabarit de vitrine appliqué à une donnée d'horaire. À cette
   densité, toute la semaine tient, et aucune équipe n'est coupée.

   Le nom d'équipe FFHandball cède la place à la catégorie : sur un bandeau qui
   ne parle que du HBLM, « LUNEL MARSILLARGUES-LANSARGUES » est la seule chose
   qui se répète à chaque ligne, quand « -15 ans filles » est ce que le lecteur
   cherche.

   Aucun appel réseau côté client : tout est rendu au build (AD-9, AD-10). */
import CtaLink from './CtaLink.astro';
import {
	getMatchsDuClub,
	estDansLaFenetre,
	fenetreProchainsJours,
	libellePeriode,
	libellesParPoule,
	jourCourt,
	blocDate,
	FENETRE_SEMAINE_JOURS,
} from '../lib/matchs';

/* Une seule fenêtre pour le filtre et pour le libellé : deux calculs séparés
   finiraient par annoncer une période que la liste ne couvre pas. */
const maintenant = new Date();
const fenetre = fenetreProchainsJours(maintenant, FENETRE_SEMAINE_JOURS);
const periode = libellePeriode(fenetre.debut, fenetre.fin);

/* Tous les matchs servent à nommer les équipes : la mention de la division
   dépend du nombre d'équipes engagées par la catégorie sur la saison entière,
   pas sur la seule semaine affichée. */
const tous = await getMatchsDuClub();
const matchs = tous.filter((m) => estDansLaFenetre(m, fenetre));
const libelles = libellesParPoule(tous);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{/* Pas de rencontre dans la fenêtre : la section n'existe pas. Un encart
    « aucun match cette semaine » en page d'accueil attirerait l'œil sur une
    absence — trêve de Noël, intersaison — alors que la page Matchs porte déjà
    son propre état vide. */}
{matchs.length > 0 && (
	<section class="semaine" aria-labelledby="semaine-titre">
		<div class="entete">
			<div>
				<p class="periode">Matchs · {periode}</p>
				<h2 id="semaine-titre" class="titre">
					Cette<br />semaine<span class="point">.</span>
				</h2>
			</div>
			<p class="sous-titre">
				Toutes les rencontres de nos équipes dans les {FENETRE_SEMAINE_JOURS} prochains
				jours, reprises des données officielles de la FFHandball.
			</p>
		</div>

		<ul class="lignes" id="semaine-liste">
			{matchs.map((match, index) => (
				<li class="ligne" data-debut={match.dateHeure} style={`--rang: ${index}`}>
					{/* <time> plutôt qu'un <span> : c'est une date, et lisible par une
					    machine. La fenêtre tenant sur sept jours, le mois n'y lève
					    aucune ambiguïté — il coûterait une colonne pour rien. */}
					<time class="quand" datetime={match.dateHeure!}>
						<span class="jour">{jourCourt(match.dateHeure)}</span>
						<span class="heure">{blocDate(match.dateHeure)!.heure}</span>
					</time>

					{/* La catégorie porte le nom du club sans le répéter. Sans fiche de
					    catégorie rattachée à la poule, on retombe sur le nom brut plutôt
					    que sur rien. */}
					<p class="equipe">{libelles.get(match.poolId) ?? match.equipeClub}</p>

					<p class="adversaire"><span class="contre">contre</span> {match.adversaire}</p>

					{/* Colonne à part, et non collé derrière l'adversaire : les noms
					    d'adversaire n'ont pas la même longueur, ce qui dispersait la
					    mention sur 116 px horizontalement — l'œil ne pouvait pas la
					    balayer verticalement, qui est pourtant la seule question posée
					    ici (« lesquels se jouent chez nous ? »).

					    Domicile et extérieur se distinguent par le mot et par le poids,
					    jamais par la couleur seule. */}
					<p class="lieu" data-domicile={String(match.domicile)}>
						{match.domicile ? 'Domicile' : 'Extérieur'}
					</p>
				</li>
			))}
		</ul>

		{/* Visible seulement si le script a écarté toutes les lignes — tous les
		    matchs de la fenêtre ont été joués depuis le dernier build. */}
		<p class="vide" id="semaine-vide" hidden>
			Les rencontres de ces derniers jours sont terminées.
		</p>

		<div class="cta-row">
			<CtaLink href={`${base}/matchs`} label="Tous les matchs" />
		</div>
	</section>
)}

<script is:inline>
	(() => {
		const liste = document.getElementById('semaine-liste');
		if (!liste) return;

		/* Le site est rebuildé une fois par jour (cron de deploy.yml). Sans ce
		   réajustement, un match joué samedi à 12h resterait annoncé « cette
		   semaine » jusqu'au lendemain 3h — soit tout le samedi après-midi, quand
		   l'accueil est le plus consulté. Même motif que la page Matchs.

		   Ici la comparaison passe bien par un `Date` : on est dans le navigateur
		   du visiteur, à l'heure du club, et non sur un serveur de build en UTC. */
		const maintenant = Date.now();
		liste.querySelectorAll('li[data-debut]').forEach((ligne) => {
			const debut = ligne.dataset.debut;
			if (debut && new Date(debut).getTime() < maintenant) ligne.remove();
		});

		if (!liste.querySelector('li')) {
			liste.hidden = true;
			const vide = document.getElementById('semaine-vide');
			if (vide) vide.hidden = false;
			return;
		}

		/* Apparition en fondu, UNE FOIS, à l'entrée dans le champ de vision. Le
		   mouvement sert ici la découverte d'une section, jamais la lecture d'un
		   horaire : rien ne défile, rien ne disparaît, rien n'attend son tour —
		   deux horaires restent comparables d'un coup d'œil, ce qu'un carrousel
		   interdit.

		   La classe `prete` n'est posée que par ce script : sans JavaScript, les
		   lignes restent visibles au lieu d'être opaques à zéro pour toujours. Et
		   rien du tout si le visiteur a demandé moins d'animations. */
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		if (!('IntersectionObserver' in window)) return;
		liste.classList.add('prete');

		const reveler = () => liste.classList.add('anime');
		const observateur = new IntersectionObserver(
			(entrees) => {
				for (const entree of entrees) {
					if (!entree.isIntersecting) continue;
					reveler();
					observateur.disconnect();
				}
			},
			{ threshold: 0.15 },
		);
		observateur.observe(liste);

		/* Filet de sécurité. `prete` pose les lignes à `opacity: 0` et seule
		   l'animation les ramène : tout ce qui empêcherait l'observateur de se
		   déclencher laisserait les horaires de la semaine invisibles. Aucune
		   information du club ne doit dépendre d'une animation — passé ce délai,
		   on révèle quoi qu'il arrive. */
		setTimeout(reveler, 1500);
	})();
</script>

<style>
	/* Fond de page et non `--color-surface` : la section « Accès rapides » qui
	   suit est déjà posée sur surface, et deux sections surface contiguës se
	   lisent comme un seul bloc, séparées par un filet doublé. Le filet du haut
	   suffit à détacher le bandeau du hero. */
	.semaine {
		padding: var(--space-section-y) 5vw;
		border-top: 1px solid var(--color-border);
	}

	.entete {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: var(--space-6);
		margin-bottom: var(--space-8);
		flex-wrap: wrap;
	}

	/* La période datée plutôt que « cette semaine » seul : elle reste vérifiable
	   si un build quotidien échoue. */
	.periode {
		display: inline-block;
		font-family: var(--font-body);
		font-weight: var(--weight-body-strong);
		font-size: var(--size-eyebrow);
		letter-spacing: var(--tracking-eyebrow);
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin: 0 0 10px;
	}

	.titre {
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: clamp(40px, 7vw, 92px);
		line-height: var(--leading-display);
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
		color: var(--color-text);
		margin: 0;
	}

	.point {
		color: var(--color-accent);
	}

	.sous-titre {
		max-width: 420px;
		font-size: 15px;
		color: var(--color-text-muted);
		line-height: 1.5;
		margin: 0 0 6px;
	}

	.lignes {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border);
	}

	.lignes[hidden] {
		display: none;
	}

	/* Un filet entre les lignes plutôt qu'un cadre autour de chacune : la liste se
	   balaie comme un tableau d'affichage de gymnase, l'œil descend une colonne au
	   lieu de sauter d'un objet à l'autre. Ces lignes n'utilisent donc PAS
	   `.carte-match` — ce ne sont pas des cartes.

	   Mobile d'abord : la date tient sa colonne, l'équipe et l'adversaire
	   s'empilent à droite. */
	.ligne {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-areas:
			'quand equipe equipe'
			'quand adversaire lieu';
		align-items: baseline;
		column-gap: var(--space-4);
		padding: var(--space-3) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.quand {
		grid-area: quand;
		display: flex;
		flex-direction: column;
		min-width: 62px;
		line-height: 1.25;
	}

	.jour {
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 0.9375rem;
		text-transform: uppercase;
		color: var(--color-text);
	}

	.heure {
		font-size: 0.875rem;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.equipe {
		grid-area: equipe;
		margin: 0;
		font-size: 0.8125rem;
		font-weight: var(--weight-body-strong);
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
	}

	.adversaire {
		grid-area: adversaire;
		margin: 0;
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 1rem;
		color: var(--color-text);
	}

	.contre {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 0.9375rem;
		color: var(--color-text-muted);
	}

	/* Alignée à gauche de sa colonne : c'est l'alignement des DÉBUTS de mot qui
	   rend une colonne balayable, pas celui des fins. */
	.lieu {
		grid-area: lieu;
		justify-self: start;
		margin: 0;
		min-width: 5.5rem;
		font-size: 0.9375rem;
		color: var(--color-text-muted);
	}

	.lieu[data-domicile='true'] {
		font-weight: var(--weight-body-strong);
		color: var(--color-text);
	}

	.vide {
		margin: var(--space-6) 0 0;
		font-size: 15px;
		color: var(--color-text-muted);
	}

	.cta-row {
		display: flex;
		justify-content: center;
		margin-top: var(--space-8);
	}

	/* Une seule ligne dès qu'il y a la place : date, équipe, adversaire et lieu
	   alignés en colonnes, ce qui rend les horaires comparables d'un coup d'œil. */
	@media (min-width: 720px) {
		.ligne {
			grid-template-columns: auto minmax(0, 15rem) minmax(0, 1fr) auto;
			grid-template-areas: 'quand equipe adversaire lieu';
			column-gap: var(--space-6);
		}

		.quand {
			flex-direction: row;
			align-items: baseline;
			gap: var(--space-3);
			min-width: 8.5rem;
		}
	}

	/* Le mouvement est réservé à l'arrivée de la section, une fois, et ne
	   s'applique jamais si le visiteur a demandé moins d'animations. */
	@media (prefers-reduced-motion: no-preference) {
		.lignes.prete > .ligne {
			opacity: 0;
		}

		.lignes.anime > .ligne {
			animation: apparait 420ms ease-out forwards;
			animation-delay: calc(var(--rang) * 55ms);
		}

		@keyframes apparait {
			from {
				opacity: 0;
				transform: translateY(6px);
			}
			to {
				opacity: 1;
				transform: none;
			}
		}
	}
</style>
