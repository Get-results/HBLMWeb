---
/*
 * Navigation principale du site.
 * Montée une seule fois par BaseLayout, jamais par page.
 *
 * Mobile : menu hamburger qui affiche la liste de liens en overlay.
 * Desktop (≥640px) : liens horizontaux dans la barre.
 *
 * Le ThemeToggle vit dans la barre, à côté du hamburger. Posé auparavant en
 * `position: fixed` par-dessus la page, il flottait au-dessus du contenu et
 * chevauchait le header au défilement.
 */
import ThemeToggle from './ThemeToggle.astro';

import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
	{/* Le blason porte déjà « HBLM » dans son dessin : sur mobile, où la barre
	    doit aussi loger le hamburger, il se suffit et le logotype texte est
	    masqué. Sur desktop les deux cohabitent, le texte restant la cible de
	    clic lisible. L'aria-label du lien couvre les deux cas, d'où le blason
	    en alt="" (décoratif). */}
	<a href={`${base}/`} class="site-logo" aria-label="Accueil HBLM">
		<Logo size={36} class="logo-blason" />
		{/* Le sigle et son point sont enveloppés ensemble : le `gap` du flex
		    s'appliquerait sinon aussi entre les deux et décollerait le point. */}
		<span class="logo-text">HBLM<span class="logo-dot">.</span></span>
	</a>

	{/* Les deux commandes de la barre. L'ordre du DOM est celui du mobile : le
	    hamburger précède le menu qu'il ouvre (aria-controls). En desktop, où le
	    menu revient dans la barre, `order` replace le groupe après la nav —
	    voir la règle .header-actions dans la media query plus bas. */}
	<div class="header-actions">
		<ThemeToggle />

		<button
			id="nav-toggle"
			class="icon-button nav-toggle"
			type="button"
			aria-label="Ouvrir le menu"
			aria-expanded="false"
			aria-controls="nav-menu"
		>
			<svg class="icon-menu" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<line x1="3" y1="6" x2="21" y2="6" />
				<line x1="3" y1="12" x2="21" y2="12" />
				<line x1="3" y1="18" x2="21" y2="18" />
			</svg>
			<svg class="icon-close" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<line x1="18" y1="6" x2="6" y2="18" />
				<line x1="6" y1="6" x2="18" y2="18" />
			</svg>
		</button>
	</div>

	<nav id="nav-menu" class="nav-menu" aria-label="Navigation principale">
		<ul class="nav-list">
			<li><a href={`${base}/planning`}>Planning</a></li>
			<li><a href={`${base}/inscription`}>Inscription</a></li>
			<li><a href={`${base}/stages`}>Stages</a></li>
			<li><a href={`${base}/le-club`}>Le club</a></li>
			<li><a href={`${base}/matchs`}>Matchs</a></li>
		</ul>
	</nav>
</header>

<style>
	/* Hauteur du header, déclarée une fois et réutilisée par l'overlay du menu
	   mobile qui doit commencer juste en dessous. Elle est pilotée par le plus
	   haut de ses enfants — le bouton hamburger, 44px, cible tactile minimale
	   — plus les deux paddings verticaux et la bordure : 44 + 2x16 + 1 = 77.
	   Le blason (34px) tient dedans sans la changer.
	   Elle valait 57px en dur, ce qui ne correspondait plus au rendu : l'overlay
	   démarrait sous le header et ses premiers liens passaient derrière. */
	.site-header {
		--header-h: 77px;
		position: sticky;
		top: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--space-4) 5vw;
		background-color: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	/* Blason + logo texte */
	.site-logo {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		text-decoration: none;
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 24px;
		color: var(--color-text);
	}

	/* :global() est nécessaire : l'<img> est rendue par Logo.astro, donc elle
	   porte le scope de CE composant-là, pas celui du header. Un sélecteur
	   scopé `.logo-blason` ne l'atteindrait jamais. Le préfixe `.site-logo`
	   garde la portée réelle limitée au header. */
	.site-logo :global(.logo-blason) {
		display: block; /* sinon l'img, inline, traîne un blanc de ligne de base */
		flex-shrink: 0;
	}

	/* Sur mobile le blason porte déjà le sigle : le texte ferait doublon dans
	   une barre qui doit aussi loger le hamburger. */
	.logo-text {
		display: none;
	}

	.logo-dot {
		color: var(--color-accent);
	}

	/* Groupe de commandes, aligné à droite de la barre */
	.header-actions {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	/* Hamburger — visible uniquement sur mobile.
	   L'habillage vient de `.icon-button` (global.css), partagé avec la bascule
	   de thème ; ici on ne règle que ce qui lui est propre : les deux icônes. */

	.icon-close {
		display: none;
	}

	.nav-toggle[aria-expanded='true'] .icon-menu {
		display: none;
	}

	.nav-toggle[aria-expanded='true'] .icon-close {
		display: block;
	}

	/* Menu mobile — overlay plein écran */
	.nav-menu {
		display: none;
		position: fixed;
		inset: 0;
		top: var(--header-h); /* commence juste sous le header, qui est son parent */
		z-index: 49;
		background-color: var(--color-bg);
		padding: var(--space-8) 5vw;
	}

	.nav-menu.is-open {
		display: block;
	}

	.nav-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.nav-list a {
		display: block;
		text-decoration: none;
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 20px;
		color: var(--color-text);
		padding: var(--space-2) 0;
	}

	.nav-list a:hover {
		color: var(--color-accent);
	}

	/* Desktop : ≥640px */
	@media (min-width: 640px) {
		.logo-text {
			display: inline;
		}

		.nav-toggle {
			display: none;
		}

		/* Les liens rejoignent la barre et poussent le groupe de commandes tout
		   à droite. `order` remet le groupe après la nav : dans le DOM il la
		   précède, pour que le hamburger vienne avant les liens qu'il ouvre. */
		.nav-menu {
			display: block;
			position: static;
			background: none;
			padding: 0;
			margin-left: auto;
		}

		.header-actions {
			order: 1;
			margin-left: var(--space-6);
		}

		.nav-list {
			flex-direction: row;
			gap: var(--space-6);
		}

		.nav-list a {
			font-size: 14px;
			font-weight: var(--weight-body-strong);
			font-family: var(--font-body);
			padding: 0;
		}
	}
</style>

<script>
	const toggle = document.getElementById('nav-toggle');
	const menu = document.getElementById('nav-menu');

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!isOpen));
		toggle.setAttribute('aria-label', isOpen ? 'Ouvrir le menu' : 'Fermer le menu');
		menu?.classList.toggle('is-open', !isOpen);
	});

	/* Ferme le menu quand on clique un lien (navigation SPA-like d'Astro ou non) */
	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			toggle?.setAttribute('aria-expanded', 'false');
			toggle?.setAttribute('aria-label', 'Ouvrir le menu');
			menu.classList.remove('is-open');
		});
	});
</script>
