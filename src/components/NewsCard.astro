---
/*
 * Carte d'actualité — visuel, badges, titre et description courte.
 *
 * Utilisée dans le carrousel d'actualités de l'accueil et sur la
 * future page "Vie du club".
 *
 * Props :
 *   title       — titre de l'actu
 *   description — texte court
 *   date        — label de date affiché dans le badge accent
 *   category    — label de catégorie (badge sombre)
 *   coverPhoto  — photo de couverture et son alt, ou null (Story 4.2)
 *   href        — adresse de l'article ; sans elle la carte reste inerte
 *   brouillon   — marque « non publié », visible en développement seulement
 *   icon        — HTML SVG du placeholder (slot nommé "icon", optionnel)
 *
 * Story 4.2 : le visuel placeholder (rayures + icône) existait déjà ici, il n'y
 * a donc RIEN à construire pour l'absence de photo — juste à brancher la photo
 * quand elle est là. Un article sans `coverPhoto` retombe sur le placeholder
 * d'origine, la mise en page ne bouge pas.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AvertissementDemonstration from './AvertissementDemonstration.astro';

interface Props {
	title: string;
	description: string;
	date: string;
	category: string;
	coverPhoto?: { src: ImageMetadata; alt: string } | null;
	href?: string | null;
	brouillon?: boolean;
	demonstration?: boolean;
}

const {
	title,
	description,
	date,
	category,
	coverPhoto = null,
	href = null,
	brouillon = false,
	demonstration = false,
} = Astro.props;
---

<article class:list={['news-card', { 'news-card--lien': href }]}>
	<div class="card-visual">
		{coverPhoto ? (
			/* `widths` couvre les deux largeurs réellement rendues (320px de carte,
			   78vw sur mobile) en 1x et 2x : au-delà, on ferait fabriquer au build
			   des fichiers que personne ne télécharge. */
			<Image
				class="card-photo"
				src={coverPhoto.src}
				alt={coverPhoto.alt}
				widths={[320, 640]}
				sizes="(max-width: 639px) 78vw, 320px"
			/>
		) : (
			<slot name="icon">
				{/* Icône placeholder par défaut — ballon de handball stylisé */}
				<svg class="visual-icon" viewBox="0 0 24 24" width="52" height="52" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
					<path d="M4 12c2-3 14-3 16 0M4 12c2 3 14 3 16 0M12 3v18" stroke="currentColor" stroke-width="1.5" />
				</svg>
			</slot>
		)}
	</div>
	<div class="card-body">
		<div class="badge-row">
			<span class="badge badge-accent">{date}</span>
			<span class="badge badge-category">{category}</span>
			{brouillon && <span class="badge badge-brouillon">Brouillon</span>}
		</div>
		{/* Le lien porte le TITRE et non la carte entière : une synthèse vocale
		    qui liste les liens d'une page annonce alors « Reprise des
		    entraînements » et non le paragraphe complet. La zone cliquable, elle,
		    est étendue à toute la carte par `.card-lien::after` — le confort au
		    doigt sans le coût pour le lecteur d'écran. */}
		<h3 class="card-title">
			{href ? <a class="card-lien" href={href}>{title}</a> : title}
		</h3>
		<p class="card-desc">{description}</p>
		{/* Sous la description et non au-dessus du titre : la carte reste lisible
		    comme une carte, et l'avertissement se lit juste avant qu'on décide de
		    cliquer. La page de l'article, elle, porte la version complète. */}
		{demonstration && <AvertissementDemonstration compact />}
	</div>
</article>

<style>
	.news-card {
		flex: 0 0 auto;
		width: 320px;
		scroll-snap-align: start;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		position: relative;
	}

	/* Visuel placeholder — motif de rayures et icône centrée */
	.card-visual {
		aspect-ratio: var(--ratio-card-visual);
		background:
			repeating-linear-gradient(
				135deg,
				var(--color-visual-a) 0px,
				var(--color-visual-a) 10px,
				var(--color-visual-b) 10px,
				var(--color-visual-b) 20px
			);
		display: flex;
		align-items: center;
		justify-content: center;
		border-bottom: 1px solid var(--color-border);
		position: relative;
	}

	/* La photo remplit le gabarit 3:2 du visuel ; `object-fit: cover` recadre
	   plutôt que de déformer — une photo d'équipe étirée est pire qu'un cadrage
	   serré. */
	.card-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.visual-icon {
		opacity: 0.55;
		color: var(--color-text);
	}

	/* Corps de la carte */
	.card-body {
		padding: 20px 20px 24px;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		flex: 1;
	}

	/* Badges pilules chevauchant le visuel */
	.badge-row {
		display: flex;
		gap: var(--space-2);
		align-items: center;
		flex-wrap: wrap;
		margin-top: -34px;
		position: relative;
		z-index: 2;
	}

	.badge {
		display: inline-block;
		font-family: var(--font-body);
		font-weight: var(--weight-body-strong);
		font-size: 12px;
		letter-spacing: 0.02em;
		padding: 6px 14px;
		border-radius: var(--radius-full);
		box-shadow: 0 1px 0 rgba(34, 34, 32, 0.08);
		white-space: nowrap;
	}

	/* Badge accent — texte TOUJOURS #222220 fixe (DESIGN.md > Colors, règle stricte) */
	.badge-accent {
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	/* Badge catégorie — fond = couleur de texte, texte = couleur de surface (inversé) */
	.badge-category {
		background: var(--color-text);
		color: var(--color-surface);
	}

	.card-title {
		font-size: 20px;
		line-height: 1.22;
		margin: var(--space-1) 0 0;
		/* Un titre d'article peut être long et ne comporter aucune espace utile
		   pour couper ; sans ça il déborderait de la carte de 320px. */
		overflow-wrap: anywhere;
	}

	/* Carte cliquable ------------------------------------------------------- */

	.news-card--lien {
		/* Ancre de positionnement du `::after` ci-dessous. */
		position: relative;
		transition: border-color 120ms ease, transform 120ms ease;
	}

	.news-card--lien:hover {
		border-color: var(--color-accent);
		transform: translateY(-2px);
	}

	@media (prefers-reduced-motion: reduce) {
		.news-card--lien { transition: border-color 120ms ease; }
		.news-card--lien:hover { transform: none; }
	}

	.card-lien {
		color: inherit;
		text-decoration: none;
	}

	.card-lien:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* Étend la zone cliquable du lien à toute la carte. Le `z-index: 1` le place
	   au-dessus du visuel et des badges, mais le texte reste sélectionnable
	   au-dessus de lui — c'est le compromis habituel de ce motif. */
	.card-lien::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	/* Le focus clavier se dessine sur la CARTE et non sur le titre seul : c'est
	   la carte entière qui est la cible, un contour autour de trois mots
	   désignerait mal ce qu'on s'apprête à activer (NFR3). */
	.card-lien:focus-visible {
		outline: none;
	}

	.news-card--lien:has(.card-lien:focus-visible) {
		outline: 3px solid var(--color-accent);
		outline-offset: 3px;
	}

	/* Badge « Brouillon » — jamais rendu en production (voir src/lib/articles.ts).
	   Volontairement dissonant : il doit se lire comme un avertissement de
	   travail en cours, pas comme une catégorie éditoriale de plus. */
	.badge-brouillon {
		background: transparent;
		color: var(--color-text);
		border: 1px dashed var(--color-text-muted);
		box-shadow: none;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.card-desc {
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-text-muted);
		margin: 0;
	}

	/* Mobile : les cartes prennent 78vw */
	@media (max-width: 639px) {
		.news-card {
			width: 78vw;
			flex-basis: 78vw;
		}
	}
</style>
