---
/* Page Matchs — stories 3.2, 3.4 et 3.5 (AD-10).

   Seconde île du site, et la seule logique cliente ici est le filtre : la liste
   entière est rendue au build, le filtre ne fait que masquer des lignes. Sans
   JavaScript, tous les matchs restent visibles — le filtre disparaît, pas le
   contenu.

   Aucun appel réseau au clic (AD-10) et aucun appel à l'API depuis le navigateur
   (AD-9) : les données viennent de la collection produite au build. */
import { getMatchsDuClub, formaterDateMatch } from '../lib/matchs';
import GenericContact from './GenericContact.astro';

const matchs = await getMatchsDuClub();

/* Équipes proposées au filtre : uniquement celles qui ont au moins un match.
   Lister une catégorie sans match donnerait un filtre qui vide la page. */
const equipes = [...new Map(
	matchs
		.filter((m) => m.categorieId)
		.map((m) => [m.categorieId!, m.categorieLabel!]),
).entries()].sort((a, b) => a[1].localeCompare(b[1], 'fr'));
---

{matchs.length === 0 ? (
	<div class="vide">
		<p class="vide-titre">Aucun match à afficher pour le moment</p>
		<p>
			Le calendrier est repris automatiquement des données officielles de la
			FFHandball. Il se remplira dès que les rencontres de la saison seront
			publiées.
		</p>
		<GenericContact intro="Une question sur le calendrier ? Écrivez-nous." discret />
	</div>
) : (
	<>
		{equipes.length > 1 && (
			<div class="filtre">
				{/* Un <select> natif plutôt qu'un groupe de boutons : il est accessible
				    au clavier et aux lecteurs d'écran sans qu'on réimplémente quoi que
				    ce soit, et il tient la longueur quand le nombre d'équipes grandit. */}
				<label for="filtre-equipe">Filtrer par équipe</label>
				<select id="filtre-equipe">
					<option value="">Toutes les équipes</option>
					{equipes.map(([id, label]) => <option value={id}>{label}</option>)}
				</select>
				{/* Le compte change sans rechargement : un lecteur d'écran ne le
				    remarquerait pas sans aria-live. */}
				<p class="compte" aria-live="polite" data-total={matchs.length}>
					{matchs.length} match{matchs.length > 1 ? 's' : ''}
				</p>
			</div>
		)}

		<ul class="matchs">
			{matchs.map((match) => {
				const date = formaterDateMatch(match.dateHeure);
				const joue = match.scoreClub !== null && match.scoreAdversaire !== null;
				return (
					<li class="match" data-equipe={match.categorieId ?? ''}>
						<div class="entete">
							<span class="date">{date ?? 'Date à préciser'}</span>
							{match.categorieLabel && <span class="equipe">{match.categorieLabel}</span>}
						</div>

						<p class="rencontre">
							<span class="lieu" data-domicile={String(match.domicile)}>
								{match.domicile ? 'Domicile' : 'Extérieur'}
							</span>
							<span class="contre">contre</span>
							<strong class="adversaire">{match.adversaire}</strong>
						</p>

						{joue ? (
							<p class="score">
								<span class="score-valeur">{match.scoreClub} – {match.scoreAdversaire}</span>
								<span class="score-issue">
									{match.scoreClub! > match.scoreAdversaire!
										? 'Victoire'
										: match.scoreClub! < match.scoreAdversaire!
											? 'Défaite'
											: 'Match nul'}
								</span>
							</p>
						) : (
							/* Story 3.4 : jamais une case vide ni une erreur. En début de
							   saison, c'est l'état de presque tous les matchs. */
							<p class="score en-attente">Résultat pas encore connu</p>
						)}

						{match.competition && (
							<p class="competition">
								{match.competition}{match.journee && ` · journée ${match.journee}`}
							</p>
						)}
					</li>
				);
			})}
		</ul>

		<p class="aucun-resultat" hidden>
			Aucun match pour cette équipe.
		</p>
	</>
)}

<script is:inline>
	(() => {
		const select = document.getElementById('filtre-equipe');
		if (!select) return;

		const lignes = [...document.querySelectorAll('.match')];
		const compte = document.querySelector('.compte');
		const vide = document.querySelector('.aucun-resultat');

		select.addEventListener('change', () => {
			const choix = select.value;
			let visibles = 0;
			lignes.forEach((ligne) => {
				const garde = !choix || ligne.dataset.equipe === choix;
				ligne.hidden = !garde;
				if (garde) visibles += 1;
			});
			if (compte) compte.textContent = `${visibles} match${visibles > 1 ? 's' : ''}`;
			if (vide) vide.hidden = visibles > 0;
		});
	})();
</script>

<style>
	.filtre {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-4);
		margin-bottom: var(--space-6);
	}

	.filtre label {
		font-weight: var(--weight-body-strong);
		font-size: 0.875rem;
	}

	.filtre select {
		min-height: 44px;
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background-color: var(--color-input-bg);
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 1rem;
	}

	.compte {
		margin: 0;
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.matchs {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-4);
	}

	.match {
		padding: var(--space-4) var(--space-6);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background-color: var(--color-surface);
	}

	.entete {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2);
		margin-bottom: var(--space-2);
	}

	.date {
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: var(--tracking-eyebrow);
		color: var(--color-text-muted);
	}

	.equipe {
		font-size: 0.8125rem;
		font-weight: var(--weight-body-strong);
		color: var(--color-text-muted);
	}

	.rencontre {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2);
		margin: 0 0 var(--space-2);
	}

	/* Domicile et extérieur se distinguent par le texte lui-même et par le
	   remplissage de la pastille, pas seulement par la couleur. */
	.lieu {
		padding: 2px var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: var(--tracking-eyebrow);
	}

	.lieu[data-domicile='true'] {
		border-color: var(--color-text);
		background-color: var(--color-text);
		color: var(--color-bg);
	}

	.contre {
		color: var(--color-text-muted);
	}

	.adversaire {
		font-family: var(--font-heading);
		font-size: 1.0625rem;
	}

	.score {
		margin: 0;
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
	}

	.score-valeur {
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 1.25rem;
		font-variant-numeric: tabular-nums;
	}

	.score-issue {
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.en-attente {
		font-size: 0.9375rem;
		color: var(--color-text-muted);
	}

	.competition {
		margin: var(--space-2) 0 0;
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.aucun-resultat,
	.vide {
		margin-top: var(--space-6);
		padding: var(--space-6);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background-color: var(--color-input-bg);
	}

	.vide-titre {
		margin: 0 0 var(--space-2);
		font-weight: var(--weight-body-strong);
	}
</style>
