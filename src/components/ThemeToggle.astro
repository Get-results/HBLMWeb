---
/*
 * Bascule clair/sombre. Montée une seule fois par le Header, jamais par page.
 *
 * Sans choix explicite, le thème est le sombre (thème de base, tokens.css) et
 * aucun `data-theme` n'est posé ; un clic force un thème et le persiste. Le
 * script précoce de BaseLayout réapplique ce choix avant le premier paint.
 *
 * `aria-pressed` est rendu à "true" : c'est l'état du visiteur sans choix
 * persisté, donc le cas dominant. Le seul écart — un visiteur ayant forcé le
 * clair — est corrigé par le script ci-dessous. L'icône, elle, est pilotée en
 * CSS pur pour qu'elle soit juste dès le premier paint, sans attendre le JS.
 */
---

<button
	id="theme-toggle"
	class="icon-button"
	type="button"
	aria-label="Basculer entre thème clair et sombre"
	aria-pressed="true"
>
	<svg class="icon icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
	</svg>
	<svg class="icon icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
	</svg>
</button>

<style>
	/* Tout l'habillage vient de `.icon-button` (global.css), partagé avec le
	   hamburger voisin : les deux commandes de la barre se ressemblent au lieu
	   de se disputer l'attention, et une retouche les touche toutes les deux.
	   Le bouton n'a donc aucun style propre — ni positionnement : il se place
	   dans le flux de la barre, qui le monte (voir Header.astro). */

	.icon {
		display: block;
	}

	/* L'icône annonce l'action, pas l'état : en sombre on propose le soleil.
	   Les deux cas reprennent exactement la cascade de tokens.css —
	   sombre par défaut, clair seulement s'il est forcé. */
	.icon-moon {
		display: none;
	}

	:global(html[data-theme='light']) .icon-moon {
		display: block;
	}

	:global(html[data-theme='light']) .icon-sun {
		display: none;
	}
</style>

<script>
	const STORAGE_KEY = 'hblm-theme';
	const root = document.documentElement;
	const button = document.getElementById('theme-toggle');

	/* Le thème réellement affiché : le clair uniquement s'il a été forcé,
	   sinon le sombre — thème de base, indépendant du réglage système. */
	function effectiveTheme() {
		return root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
	}

	function syncPressed() {
		button?.setAttribute('aria-pressed', String(effectiveTheme() === 'dark'));
	}

	syncPressed();

	button?.addEventListener('click', () => {
		const next = effectiveTheme() === 'dark' ? 'light' : 'dark';
		root.setAttribute('data-theme', next);
		syncPressed();
		try {
			localStorage.setItem(STORAGE_KEY, next);
		} catch {
			/* Navigation privée stricte : la bascule marche, elle ne survit pas au rechargement. */
		}
	});
</script>
