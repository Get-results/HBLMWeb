---
import '@fontsource/poppins/800.css';
import '@fontsource/poppins/900.css';
import '@fontsource/work-sans/400.css';
import '@fontsource/work-sans/600.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

/* Description de repli pour le partage : une page qui n'en fournit pas vaut
   mieux avec celle-ci qu'avec un aperçu vide sur WhatsApp ou Facebook. */
const {
	title,
	description = 'Le club de handball de Lunel et Marsillargues : entraînements, inscriptions, stages et matchs, de 3 ans aux seniors.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* Déclinaisons du blason du club, générées depuis src/assets/logo.webp et
   servies telles quelles depuis public/ : le favicon et l'image de partage
   sont réclamés par des clients extérieurs (onglet du navigateur, robot
   Facebook) à une URL fixe, ils ne peuvent donc pas passer par le pipeline
   d'images d'Astro qui hache les noms de fichiers. */
const favicon = `${base}/favicon.ico`;
const faviconPng = `${base}/favicon-32.png`;
const appleIcon = `${base}/apple-touch-icon.png`;

/* Open Graph exige une URL absolue — un chemin relatif est ignoré par la
   plupart des aperçus. Astro.site porte le domaine, BASE_URL le sous-chemin. */
const ogImage = new URL(`${base}/og-image.jpg`, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

/* Story 1.4 — Mesure d'audience sans cookies (NFR5, AD-11).
   Umami est inclus UNE SEULE FOIS ici, jamais page par page.
   Configurer les deux variables dans un fichier .env à la racine :
     PUBLIC_UMAMI_URL=https://ton-instance-umami.example.com/script.js
     PUBLIC_UMAMI_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
   Sans ces variables le script n'est tout simplement pas rendu. */
const umamiUrl = import.meta.env.PUBLIC_UMAMI_URL;
const umamiId = import.meta.env.PUBLIC_UMAMI_ID;
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" sizes="any" href={favicon} />
		<link rel="icon" type="image/png" sizes="32x32" href={faviconPng} />
		<link rel="apple-touch-icon" href={appleIcon} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		{/* Aperçu de partage — le club diffuse ses liens sur WhatsApp et Facebook,
		    qui n'affichaient jusqu'ici qu'une vignette vide. */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Handball Lunel-Marsillargues" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:locale" content="fr_FR" />
		<meta name="twitter:card" content="summary_large_image" />
		{/* Umami — mesure d'audience sans cookies ni profilage (NFR5).
		    Ne rend rien tant que PUBLIC_UMAMI_URL et PUBLIC_UMAMI_ID ne sont pas configurés. */}
		{umamiUrl && umamiId && (
			<script defer src={umamiUrl} data-website-id={umamiId}></script>
		)}
		{/* Applique un thème forcé avant le premier paint — sinon le sombre, thème
		    de base, s'affiche puis bascule visiblement chez un visiteur qui a
		    choisi le clair. Doit rester inline et synchrone. */}
		<script is:inline>
			try {
				var stored = localStorage.getItem('hblm-theme');
				if (stored === 'light' || stored === 'dark') {
					document.documentElement.setAttribute('data-theme', stored);
				}
			} catch (e) {
				/* localStorage indisponible : on retombe sur le thème de base (sombre). */
			}
		</script>
	</head>
	<body>
		{/* Lien d'évitement : premier élément focusable de la page, invisible tant
		    qu'il n'a pas le focus. Permet de sauter la navigation, répétée sur
		    chaque page, pour atteindre directement le contenu (WCAG 2.4.1). */}
		<a href="#contenu" class="skip-link">Aller au contenu</a>
		{/* Le Header porte la bascule de thème : elle fait partie de la barre. */}
		<Header />
		{/* tabindex="-1" : sans lui, certains navigateurs font défiler jusqu'à
		    l'ancre sans y déplacer le focus clavier — le lien d'évitement ne
		    servirait alors à rien. */}
		<main id="contenu" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
