---
/* Point d'entrée « Faire un essai » — Story 2.3.
   L'île TrouverMaCategorie est montée ici ; la Story 2.4 la montera à l'identique
   depuis « S'inscrire », avec la même résolution et la même sortie. */
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import CategoriesInfos from '../components/CategoriesInfos.astro';
import TrouverMaCategorie from '../components/TrouverMaCategorie.astro';
---

<BaseLayout title="Faire un essai | HBLM">
  <div class="container">
    <header class="page-header">
      <h1 class="title">Faire un essai</h1>
      <p class="subtitle">Venez tester le handball, sans engagement</p>
    </header>

    <section class="content-section">
      <div class="card">
        <h2>Comment ça se passe ?</h2>
        <p>Le HBLM propose des séances d'essai gratuites avant toute inscription. Vous venez, vous jouez, et vous décidez ensuite.</p>
        <p>Indiquez l'année de naissance et le genre ci-dessous : nous vous indiquons la catégorie, ses créneaux et la marche à suivre.</p>
      </div>

      <TrouverMaCategorie />

      {/* En attendant le parcours de la Story 2.3, on montre déjà les catégories
          confirmées (créneaux + dispo essai) issues de la collection `categories`.
          Même composant, même source que la page Inscription. */}
      <CategoriesInfos mode="creneaux" />

      <ContactForm />
    </section>
  </div>
</BaseLayout>
