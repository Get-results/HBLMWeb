---
/* Jalon en attendant l'Epic 4 (articles et galeries photo).
   Présente dès maintenant car l'accueil pointe dessus depuis le bloc
   actualités. À remplacer par l'affichage des articles de la Story 4.3. */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Vie du club | HBLM">
  <div class="container">
    <header class="page-header">
      <h1 class="title">Vie du club</h1>
      <p class="subtitle">Actualités, événements et photos</p>
    </header>

    <section class="content-section">
      <div class="card accent-card">
        <h2>Bientôt disponible</h2>
        <p>Les actualités du club, les comptes-rendus d'événements et les galeries photo seront rassemblés ici.</p>
        <p>En attendant, suivez-nous sur les réseaux sociaux du club.</p>
      </div>
    </section>
  </div>
</BaseLayout>
