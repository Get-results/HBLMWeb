---
/* Page d'un article — « Vie du club ».

   Jusqu'ici, le corps markdown d'un article n'était rendu NULLE PART : la
   collection le chargeait, les cartes en affichaient le titre et l'accroche, et
   le texte rédigé — la seule raison d'être d'un article — n'avait pas de page
   où paraître. C'est ce que ce fichier répare.

   Il vit dans `src/pages/vie-du-club/` à côté de `src/pages/vie-du-club.astro` :
   Astro sert le premier en `/vie-du-club/<slug>` et le second en `/vie-du-club`.
   Les deux coexistent sans se marcher dessus, et l'URL dit la hiérarchie.

   Le slug est l'`id` de l'entrée, c'est-à-dire le nom du fichier markdown. Rien
   à inventer, rien à tenir à jour : renommer le fichier renomme l'URL.

   Les galeries photo (Story 4.3) restent absentes, pour la raison déjà inscrite
   dans vie-du-club.astro : le droit à l'image est ajourné (A-FAIRE-HORS-CODE.md,
   section 2). */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GenericContact from '../../components/GenericContact.astro';
import { Image } from 'astro:assets';
import {
	getArticlesAffichables,
	formaterDateArticle,
	libelleCategorie,
	estBrouillon,
	type Article,
} from '../../lib/articles';

export async function getStaticPaths() {
	/* Une page par article AFFICHABLE, et pas par article existant : en
	   production, un brouillon n'a donc aucune page — pas même une page orpheline
	   qu'une adresse devinée atteindrait. Sous `astro dev`, les brouillons en ont
	   une, c'est tout l'intérêt de la relecture. */
	const articles = await getArticlesAffichables();
	return articles.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}));
}

interface Props {
	article: Article;
}

const { article } = Astro.props;
const { Content } = await render(article);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const brouillon = estBrouillon(article);
---

<BaseLayout title={`${article.data.title} | HBLM`} description={article.data.description}>
	<article class="page">
		<div class="entete">
			{/* Fil de retour plutôt qu'un fil d'Ariane complet : le site n'a qu'un
			    seul niveau au-dessus d'un article, une chaîne « Accueil › Vie du
			    club › Titre » ne dirait rien de plus que ce lien. */}
			<a class="retour" href={`${base}/vie-du-club`}>← Vie du club</a>

			<p class="meta">
				<span class="badge badge-accent">{formaterDateArticle(article.data.date)}</span>
				<span class="badge badge-category">{libelleCategorie(article.data.category)}</span>
			</p>

			<h1 class="titre">{article.data.title}</h1>
			<p class="chapeau">{article.data.description}</p>

			{brouillon && (
				/* Visible en développement seulement : en production, un brouillon
				   n'a pas de page du tout. L'avertissement est écrit en toutes
				   lettres, pas seulement signalé par une couleur — on doit pouvoir
				   le lire sans distinguer les teintes, et dans une capture d'écran
				   envoyée à quelqu'un d'autre. */
				<p class="bandeau-brouillon">
					<strong>Brouillon</strong> — cet article n'est pas publié. Il est visible
					ici parce que le site tourne en local&nbsp;; il n'existe sur aucune page
					du site en ligne.
				</p>
			)}
		</div>

		{article.data.coverPhoto && (
			<figure class="couverture">
				{/* Largeurs réellement rendues : 760px de colonne de lecture en 1x et
				    2x, plus une valeur mobile. Rien au-delà — ce seraient des
				    fichiers fabriqués au build que personne ne télécharge. */}
				<Image
					src={article.data.coverPhoto.src}
					alt={article.data.coverPhoto.alt}
					widths={[480, 760, 1520]}
					sizes="(max-width: 860px) 92vw, 760px"
				/>
			</figure>
		)}

		<div class="corps">
			<Content />
		</div>

		<div class="pied">
			<GenericContact
				intro="Une précision à apporter sur cet article&nbsp;? Écrivez-nous."
				discret
			/>
			<a class="retour retour-bas" href={`${base}/vie-du-club`}>← Tous les articles</a>
		</div>
	</article>
</BaseLayout>

<style>
	.page {
		width: 100%;
		padding: var(--space-section-y) 6vw;
	}

	/* 760px : une colonne de lecture d'environ 75 caractères en 16px. Au-delà,
	   l'œil perd la ligne suivante en revenant à la marge gauche. */
	.entete,
	.couverture,
	.corps,
	.pied {
		max-width: 760px;
		margin-left: auto;
		margin-right: auto;
	}

	.retour {
		display: inline-block;
		font-family: var(--font-body);
		font-weight: var(--weight-body-strong);
		font-size: var(--size-eyebrow);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		text-decoration: none;
		/* Zone tactile ≥44px sans déplacer le texte : la marge négative annule le
		   rembourrage horizontal, seule la hauteur de cible reste (NFR3). */
		padding: 12px 8px;
		margin: -12px 0 var(--space-6) -8px;
	}

	.retour:hover {
		color: var(--color-text);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0 0 var(--space-4);
	}

	.badge {
		display: inline-block;
		font-family: var(--font-body);
		font-weight: var(--weight-body-strong);
		font-size: 12px;
		letter-spacing: 0.02em;
		padding: 6px 14px;
		border-radius: var(--radius-full);
		white-space: nowrap;
	}

	.badge-accent {
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	.badge-category {
		background: var(--color-text);
		color: var(--color-surface);
	}

	.titre {
		font-family: var(--font-display);
		font-weight: var(--weight-display);
		font-size: clamp(30px, 5vw, 52px);
		line-height: 1.04;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
		color: var(--color-text);
		margin: 0 0 var(--space-4);
		/* Un titre d'article vient du contenu : il peut être bien plus long que
		   ceux des pages fixes, et rien ne garantit qu'il coupe proprement. */
		overflow-wrap: anywhere;
	}

	.chapeau {
		font-size: 1.125rem;
		line-height: 1.55;
		color: var(--color-text-muted);
		margin: 0;
	}

	.bandeau-brouillon {
		margin: var(--space-6) 0 0;
		padding: var(--space-4);
		border: 1px dashed var(--color-text-muted);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		color: var(--color-text);
		font-size: 0.95rem;
		line-height: var(--leading-body);
	}

	.couverture {
		margin: var(--space-8) auto 0;
	}

	.couverture :global(img) {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	/* Corps de l'article --------------------------------------------------- */

	/* `:global` est nécessaire et non un raccourci : le markdown est rendu par
	   <Content />, ses balises ne portent donc pas l'attribut de portée que le
	   compilateur ajoute au balisage écrit dans ce fichier. Tout est confiné
	   sous `.corps`, qui n'existe que sur cette page. */
	.corps {
		margin-top: var(--space-8);
		font-size: var(--size-body);
		line-height: 1.65;
		color: var(--color-text);
	}

	.corps :global(p) {
		margin: 0 0 var(--space-6);
	}

	.corps :global(h2) {
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: clamp(22px, 3.2vw, 28px);
		line-height: 1.2;
		letter-spacing: 0.01em;
		margin: var(--space-8) 0 var(--space-4);
	}

	.corps :global(h3) {
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 1.125rem;
		line-height: 1.3;
		margin: var(--space-6) 0 var(--space-3);
	}

	.corps :global(ul),
	.corps :global(ol) {
		margin: 0 0 var(--space-6);
		padding-left: 1.4em;
	}

	.corps :global(li) {
		margin-bottom: var(--space-2);
	}

	.corps :global(li::marker) {
		color: var(--color-accent);
	}

	.corps :global(strong) {
		font-weight: var(--weight-body-strong);
	}

	/* Filet accent à gauche plutôt qu'un fond coloré : la citation se distingue
	   sans introduire une seconde surface dans la colonne de lecture. */
	.corps :global(blockquote) {
		margin: 0 0 var(--space-6);
		padding: var(--space-2) 0 var(--space-2) var(--space-4);
		border-left: 3px solid var(--color-accent);
		color: var(--color-text-muted);
		font-style: italic;
	}

	.corps :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	/* Les liens du corps sont soulignés en permanence : dans un paragraphe, la
	   couleur seule ne suffit pas à les distinguer (NFR3). */
	.corps :global(a) {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}

	.corps :global(a:hover) {
		color: var(--color-accent);
	}

	.corps :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: var(--radius-md);
	}

	.corps :global(hr) {
		border: none;
		border-top: 1px solid var(--color-border);
		margin: var(--space-8) 0;
	}

	.corps :global(code) {
		font-size: 0.9em;
		padding: 2px 6px;
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
	}

	.corps :global(pre) {
		overflow-x: auto;
		padding: var(--space-4);
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
		margin: 0 0 var(--space-6);
	}

	.corps :global(pre code) {
		border: none;
		padding: 0;
		background: none;
	}

	/* Un tableau reste lisible sur petit écran en défilant dans sa propre boîte,
	   plutôt qu'en élargissant toute la page. */
	.corps :global(table) {
		display: block;
		overflow-x: auto;
		width: 100%;
		border-collapse: collapse;
		margin: 0 0 var(--space-6);
	}

	.corps :global(th),
	.corps :global(td) {
		border: 1px solid var(--color-border);
		padding: var(--space-2) var(--space-3);
		text-align: left;
	}

	.pied {
		margin-top: var(--space-8);
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border);
	}

	.retour-bas {
		margin: var(--space-6) 0 0 -8px;
	}

	@media (max-width: 640px) {
		.page { padding: 40px 5vw 64px; }
	}
</style>
