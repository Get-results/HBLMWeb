---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import CategoriesInfos from '../components/CategoriesInfos.astro';
import TrouverMaCategorie from '../components/TrouverMaCategorie.astro';

const baseUrl = import.meta.env.BASE_URL;
const essaiUrl = baseUrl.endsWith('/') ? `${baseUrl}essai` : `${baseUrl}/essai`;
---

<BaseLayout title="Inscription | HBLM">
  <div class="container">
    <header class="page-header">
      <h1 class="title">Inscription</h1>
      <p class="subtitle">Rejoignez le Handball Lunel-Marsillargues</p>
    </header>
    
    <section class="content-section">
      <div class="card">
        <h2>Bienvenue au club !</h2>
        <p>Le HBLM vous accueille dès l'âge de 3 ans (baby-hand) jusqu'aux seniors. Que vous souhaitiez jouer en compétition ou simplement pour le plaisir et le loisir, il y a une place pour vous sur le terrain.</p>
        <p>Les inscriptions se déroulent généralement en début de saison, courant septembre.</p>
      </div>

      <div class="card">
        <h2>Pièces à fournir</h2>
        <ul class="list">
          <li>Certificat médical (ou questionnaire de santé)</li>
          <li>Photo d'identité récente</li>
          <li>Règlement de la licence</li>
        </ul>
      </div>

      {/* Second point d'entrée du parcours (Story 2.4) : exactement le même
          composant que sur « Faire un essai », donc la même résolution et la
          même fiche en sortie. Le monter ici plutôt que d'y renvoyer évite au
          visiteur un aller-retour pour une question qu'il se pose déjà. */}
      <TrouverMaCategorie />

      {/* Les tarifs viennent de la collection `categories` (Story 2.1) et non
          d'un texte saisi ici : c'est la même source que « Trouver ma catégorie »,
          donc les deux ne peuvent pas diverger. Tant qu'aucune fiche n'est
          confirmée par le bureau, le composant affiche « en cours de
          préparation » — jamais un tarif inventé. */}
      <CategoriesInfos mode="tarifs" />

      {/* Renvoi vers « Faire un essai » et non vers l'outil, qui est désormais
          juste au-dessus : y envoyer le visiteur le ferait tourner en rond. */}
      <div class="card cta-card">
        <h2>Envie d'essayer avant de vous inscrire ?</h2>
        <p>Le club propose des séances d'essai gratuites. Elles sont présentées sur la page dédiée.</p>
        <a href={essaiUrl} class="button">En savoir plus sur les séances d'essai</a>
      </div>

      <ContactForm />
    </section>
  </div>
</BaseLayout>

