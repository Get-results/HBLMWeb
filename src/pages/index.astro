---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaLink from '../components/CtaLink.astro';
import QuickLink from '../components/QuickLink.astro';
import NewsCard from '../components/NewsCard.astro';
import Logo from '../components/Logo.astro';
import MatchsDeLaSemaine from '../components/MatchsDeLaSemaine.astro';
import {
	getArticlesAffichables,
	formaterDateArticle,
	libelleCategorie,
	estBrouillon,
	estDemonstration,
	urlArticle,
} from '../lib/articles';
import { licencies } from '../lib/club';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* Le carrousel portait quatre cartes écrites en dur, dont le contenu ne
   relatait aucun fait vérifié du club — « 351 licenciés en 2025, un record ! »,
   « Retour en images » sans la moindre image — et dont deux « dates » n'en
   étaient pas (« Récent », « 2025»). C'était publié, sur un site en ligne, et
   c'est précisément ce que le garde-fou de la collection `articles` existe pour
   empêcher. L'accueil lit donc la même source que « Vie du club », par le même
   point de passage : ce qui n'est pas `publie` n'apparaît ni ici ni là-bas.

   Quatre articles : le carrousel en montrait quatre, et c'est ce que la bande
   défilante accueille sans que la dernière carte soit coupée trop tôt. */
const articles = (await getArticlesAffichables()).slice(0, 4);
---

<BaseLayout title="Handball Lunel-Marsillargues">
	{/* ──────────────── HERO ──────────────── */}
	<section class="hero">
		{/* Filigrane décoratif, donc alt="" : il ne dit rien que le titre ne
		    dise déjà, et le blason lisible est dans le header juste au-dessus. */}
		<Logo size={520} class="hero-filigrane" />

		<p class="eyebrow">HBLM · Club de handball</p>
		<h1 class="display hero-title">
			Le handball<br />à Lunel et<br />Marsillargues<span class="accent-dot">.</span>
		</h1>
		<p class="hero-sub">
			À partir de 3 ans, venez découvrir le handball
			sur Lunel et Marsillargues.
		</p>
		<div class="hero-actions">
			<CtaLink href={`${base}/essai`} label="Faire un essai" />
			<a href={`${base}/matchs`} class="hero-link">Consulter les matchs</a>
		</div>
	</section>

	{/* ──────────────── MATCHS DE LA SEMAINE ──────────────── */}
	{/* Juste sous le hero : c'est la question qu'un licencié ou un parent se pose
	    en arrivant sur le site un vendredi. La section se retire d'elle-même quand
	    aucune rencontre n'est programmée dans les sept jours. */}
	<MatchsDeLaSemaine />

	{/* ──────────────── RACCOURCIS ──────────────── */}
	<section class="section quick-links-section" aria-label="Accès rapides">
		<div class="section-header">
			<h2 class="display section-title">
				Accès<br />rapides<span class="accent-dot">.</span>
			</h2>
		</div>
		<div class="quick-links-grid">
			<QuickLink
				href={`${base}/essai`}
				title="Faire un essai"
				description="Trouvez votre catégorie et venez tester gratuitement."
			>
				<svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="9" />
					<path d="M4 12c2-3 14-3 16 0M4 12c2 3 14 3 16 0M12 3v18" />
				</svg>
			</QuickLink>

			<QuickLink
				href={`${base}/inscription`}
				title="S'inscrire"
				description="Toutes les infos pour rejoindre le club."
			>
				<svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="4" y="3" width="16" height="18" rx="1.5" />
					<path d="M8 8h8M8 12h8M8 16h5" />
				</svg>
			</QuickLink>

			<QuickLink
				href={`${base}/planning`}
				title="Planning"
				description="Créneaux d'entraînement par catégorie."
			>
				<svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="4" width="18" height="17" rx="2" />
					<line x1="3" y1="10" x2="21" y2="10" />
					<line x1="9" y1="4" x2="9" y2="10" />
					<line x1="15" y1="4" x2="15" y2="10" />
				</svg>
			</QuickLink>

			<QuickLink
				href={`${base}/matchs`}
				title="Matchs & Résultats"
				description="Calendrier et scores de toutes les équipes."
			>
				<svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M12 3l2.4 5.6L20 9.3l-4.2 3.8L17 19l-5-3.1L7 19l1.2-5.9L4 9.3l5.6-.7L12 3z" stroke-linejoin="round" />
				</svg>
			</QuickLink>
		</div>
	</section>

	{/* ──────────────── LA VIE DU CLUB ──────────────── */}
	<section class="section news-section">
		<div class="section-header">
			<div>
				<p class="eyebrow">HBLM · Handball Lunel-Marsillargues</p>
				<h2 class="display section-title">
					La vie<br />du club<span class="accent-dot">.</span>
				</h2>
			</div>
			{/* « records de licenciés » retiré : c'était la même affirmation non
			    étayée que le « 351 licenciés, un record ! » du bloc plus bas. */}
			<p class="section-sub">
				Entraînements, inscriptions, stages, événements :
				tout ce qui fait vivre le club, semaine après semaine.
			</p>
		</div>

		{/* Section masquée quand rien n'est publié — plutôt qu'un carrousel vide,
		    ou que le contenu inventé qui s'y trouvait. Le lien « Voir toutes les
		    actualités » reste, lui : la page existe et porte son propre état vide. */}
		{articles.length > 0 ? (
			<div class="carousel-wrap">
				<div class="carousel" tabindex="0" role="region" aria-label="Actualités du club, défilement horizontal">
					{articles.map((article) => (
						<NewsCard
							title={article.data.title}
							description={article.data.description}
							date={formaterDateArticle(article.data.date)}
							category={libelleCategorie(article.data.category)}
							coverPhoto={article.data.coverPhoto}
							href={urlArticle(article)}
							brouillon={estBrouillon(article)}
							demonstration={estDemonstration(article)}
						/>
					))}
				</div>
			</div>
		) : (
			<p class="news-vide">
				Les premières actualités de la saison paraîtront ici.
			</p>
		)}

		<div class="cta-row">
			<CtaLink href={`${base}/vie-du-club`} label="Voir toutes les actualités" />
		</div>
	</section>

	{/* ──────────────── LE CLUB EN BREF ──────────────── */}
	<section class="section club-brief">
		<div class="club-brief-inner">
			<h2 class="club-brief-title">Le club en bref</h2>
			{/* L'effectif ne s'affiche que confirmé par le bureau (src/lib/club.ts).
			    Plus de décompte de gymnases ici : les salles sont prêtées par les
			    communes, le club n'en possède aucune — les lister reste le rôle de
			    la page « Le club ». */}
			<p class="club-brief-text">
				{licencies.confirme && <>{licencies.nombre} licenciés, </>}
				des entraînements entre Lunel et Marsillargues,
				un bureau associatif engagé — le HBLM accueille petits et
				grands depuis des années.
			</p>
			<a href={`${base}/le-club`} class="club-brief-link">
				En savoir plus sur le club <span aria-hidden="true">→</span>
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	/* ─── Utilitaires de page ─── */
	.eyebrow {
		display: inline-block;
		font-family: var(--font-body);
		font-weight: var(--weight-body-strong);
		font-size: var(--size-eyebrow);
		letter-spacing: var(--tracking-eyebrow);
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin: 0 0 10px;
	}

	.section {
		padding: var(--space-section-y) 5vw;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: var(--space-6);
		margin-bottom: 44px;
		flex-wrap: wrap;
	}

	.section-title {
		font-size: clamp(40px, 7vw, 92px);
		line-height: var(--leading-display);
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
		color: var(--color-text);
	}

	.accent-dot {
		color: var(--color-accent);
	}

	.section-sub {
		max-width: 420px;
		font-size: 15px;
		color: var(--color-text-muted);
		line-height: 1.5;
		margin: 0 0 6px;
	}

	/* ─── HERO ─── */
	.hero {
		position: relative; /* référence du filigrane */
		padding: var(--space-section-y) 5vw;
		padding-top: clamp(48px, 10vw, 120px);
		overflow: hidden; /* le filigrane déborde à droite : on le coupe au bord */
	}

	/* Filigrane du blason, calé à droite À CÔTÉ du titre, jamais dessous.
	   :global() : l'<img> est rendue par Logo.astro et porte son scope.

	   Le seuil de 1200px n'est pas une valeur ronde choisie au hasard, il est
	   mesuré. Le titre plafonne à ~743px de glyphes (le clamp atteint son
	   maximum de 80px), et le filigrane commence à `largeur - 420px` avec les
	   valeurs ci-dessous. Les deux ne se croisent plus qu'à partir d'environ
	   1163px ; 1200 laisse une marge confortable. Descendre le seuil, agrandir
	   le blason ou réduire son décalage à droite le ferait repasser derrière le
	   texte — c'était le cas d'une première version à 900px.

	   En dessous du seuil, `display: none` : un ornement n'a pas à encombrer un
	   écran qui n'a pas la place. Cela ne dispense PAS du téléchargement — les
	   navigateurs chargent les <img> même masquées — mais c'est sans effet ici :
	   c'est la même URL que le blason du header, donc une seule requête de toute
	   façon, déjà faite. */
	.hero :global(.hero-filigrane) {
		display: none;
	}

	@media (min-width: 1200px) {
		.hero :global(.hero-filigrane) {
			display: block;
			position: absolute;
			top: 50%;
			right: -100px;
			transform: translateY(-50%);
			z-index: 0;
			/* 0.07 : assez pour qu'on devine le blason, assez peu pour que le
			   texte muted (--color-text-muted) garde son contraste par-dessus.
			   Ne pas monter sans revérifier la lisibilité dans les DEUX thèmes. */
			opacity: 0.07;
			pointer-events: none;
			user-select: none;
		}

		/* Le contenu repasse devant le filigrane. */
		.hero > :not(.hero-filigrane) {
			position: relative;
			z-index: 1;
		}
	}

	.hero-title {
		font-size: clamp(36px, 8vw, 80px);
		line-height: var(--leading-display);
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
		margin: 0 0 var(--space-6);
	}

	.hero-sub {
		max-width: 520px;
		font-size: 17px;
		line-height: 1.5;
		color: var(--color-text-muted);
		margin: 0 0 var(--space-8);
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		flex-wrap: wrap;
	}

	.hero-link {
		color: var(--color-text);
		font-weight: var(--weight-body-strong);
		text-decoration: underline;
		text-underline-offset: 4px;
		font-size: 15px;
	}

	.hero-link:hover {
		color: var(--color-accent);
	}

	/* ─── RACCOURCIS ─── */
	.quick-links-section {
		background-color: var(--color-surface);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.quick-links-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}

	@media (min-width: 640px) {
		.quick-links-grid {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-6);
		}
	}

	/* ─── CARROUSEL ACTUALITÉS ─── */
	.carousel-wrap {
		position: relative;
	}

	.carousel {
		display: flex;
		gap: var(--space-card-gap);
		overflow-x: auto;
		padding: var(--space-1) var(--space-1) var(--space-6);
		margin: 0 calc(var(--space-1) * -1);
		scroll-snap-type: x proximity;
		-webkit-overflow-scrolling: touch;
	}

	.carousel::-webkit-scrollbar {
		height: 8px;
	}

	.carousel::-webkit-scrollbar-track {
		background: var(--color-border);
		border-radius: var(--radius-sm);
	}

	.carousel::-webkit-scrollbar-thumb {
		background: var(--color-text-muted);
		border-radius: var(--radius-sm);
	}

	/* État vide de la section actualités : une phrase, au même gabarit que le
	   sous-titre de section, et pas un encart qui attirerait l'œil sur une
	   absence. */
	.news-vide {
		max-width: 720px;
		margin: 0 auto;
		padding: 0 6vw;
		text-align: center;
		font-size: var(--size-body);
		line-height: var(--leading-body);
		color: var(--color-text-muted);
	}

	.cta-row {
		display: flex;
		justify-content: center;
		margin-top: 52px;
	}

	/* ─── LE CLUB EN BREF ─── */
	.club-brief {
		background-color: var(--color-surface);
		border-top: 1px solid var(--color-border);
	}

	.club-brief-inner {
		max-width: 600px;
	}

	.club-brief-title {
		font-size: clamp(24px, 4vw, 36px);
		margin-bottom: var(--space-4);
	}

	.club-brief-text {
		color: var(--color-text-muted);
		font-size: 17px;
		line-height: 1.5;
		margin: 0 0 var(--space-6);
	}

	.club-brief-link {
		color: var(--color-text);
		font-weight: var(--weight-body-strong);
		text-decoration: underline;
		text-underline-offset: 4px;
		font-size: 15px;
	}

	.club-brief-link:hover {
		color: var(--color-accent);
	}

	/* ─── RESPONSIVE ─── */
	@media (max-width: 639px) {
		.hero {
			padding-top: var(--space-8);
		}

		.section {
			padding-left: 5vw;
			padding-right: 5vw;
		}
	}
</style>
