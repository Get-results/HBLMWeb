---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { gymnases, nombreGymnases, licencies } from '../lib/club';
import { labelsDuClub, nombreLabelsFederaux } from '../lib/labels';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* Composition transmise par le bureau le 12/09/2026 pour la saison 2026-2027,
   reprise de l'organigramme publié par le club.

   Ces personnes sont nommées publiquement : toute demande de retrait ou de
   correction passe par le bureau, et se répercute ici. Ne pas compléter cette
   liste depuis une autre source que le bureau lui-même. */
const bureau = [
	{ role: 'Présidente', nom: 'Blandine Rey' },
	{ role: 'Vice-Président', nom: 'Abde Bouchajra' },
	{ role: 'Trésorière', nom: 'Mathilde Lasalde' },
	{ role: 'Secrétaire', nom: 'Cyril Livernois' },
];

/* Les autres membres du conseil d'administration n'ont pas de fonction
   nominative, mais ils reçoivent la même carte que le bureau : ce sont des
   bénévoles au même titre, et les distinguer visuellement les dévalorisait. */
const conseilAdministration = [
	'Violaine Lagarrigue',
	'Clément Pollano',
	'Margot Galtier',
	'Julie Vernhes',
	'Errine Guillermin',
	'Mallory Mourreau',
	'Enzo Simoens',
];

const saison = '2026-2027';

/* Les photos des membres existent côté club mais n'ont pas encore été
   transmises. En attendant, l'avatar affiche les initiales : c'est déterministe,
   ça ne demande aucun fichier, et surtout ça ne se fait pas passer pour un
   portrait — un visage générique laisserait croire à une vraie photo.
   Quand les photos arriveront, remplacer le contenu du .avatar par une <img>
   et garder le cercle tel quel. Voir A-FAIRE-HORS-CODE.md. */
const initiales = (nom: string) =>
	nom
		.split(/[\s-]+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((mot) => mot[0].toUpperCase())
		.join('');
---

<BaseLayout title="Le club - HBLM">
	<div class="page-container">
		<header class="page-header">
			{/* Le blason en tête de la page institutionnelle du club — décoratif
			    (alt="") puisque le nom complet est écrit dans l'intro juste en
			    dessous. */}
			<Logo size={96} class="club-blason" />
			<h1 class="display">Le club</h1>
			<p class="intro">
				Le Handball Lunel-Marsillargues (HBLM) est un club associatif dynamique, animé par des bénévoles passionnés.
			</p>
		</header>

		<section class="club-section">
			<h2>Notre fonctionnement</h2>
			<p>
				En tant qu'association loi 1901, notre structure repose sur l'engagement de nos bénévoles. Nous accueillons les joueurs et joueuses de tout âge, dès 3 ans avec le baby-hand, jusqu'aux catégories seniors. Que vous cherchiez la compétition ou la pratique en loisir, vous trouverez votre place parmi nous.
			</p>
			
			{/* Le chiffre ne paraît que confirmé par le bureau (voir src/lib/club.ts).
			    Sinon la section se termine sur le paragraphe : mieux vaut une section
			    plus courte qu'un effectif périmé donné pour l'effectif courant. */}
			{licencies.confirme && (
				<div class="stats-card">
					<div class="stat-number display">{licencies.nombre}</div>
					<div class="stat-label">licenciés en {licencies.annee}</div>
				</div>
			)}
		</section>

		{/* Aperçu des labels, développé sur /labels. Ici on ne met que les
		    pictogrammes et leur nom : la page dédiée porte les explications, les
		    répéter ici ferait deux textes à tenir à jour pour un seul fait. */}
		<section class="club-section">
			<h2>Nos labels fédéraux</h2>
			<p>
				La Fédération française de handball distingue les clubs qui structurent durablement leur
				activité. Le HBLM est titulaire de {labelsDuClub.length} de ses {nombreLabelsFederaux} labels.
			</p>
			<ul class="labels-apercu">
				{labelsDuClub.map((label) => (
					<li>
						{/* alt vide : le nom du label est écrit juste en dessous. */}
						<span class="label-pastille">
							<Image src={label.icone} alt="" widths={[56, 112]} sizes="56px" />
						</span>
						<span class="label-nom">{label.nom}</span>
					</li>
				))}
			</ul>
			<p>
				<a class="lien-labels" href={`${base}/labels`}>Ce que chaque label récompense</a>
			</p>
		</section>

		<section class="club-section">
			<h2>Le bureau et le conseil d'administration</h2>
			<p>
				Les bénévoles qui font vivre le club au quotidien, pour la saison {saison}.
			</p>

			<h3 class="sous-titre">Le bureau</h3>
			<ul class="membres">
				{bureau.map((membre) => (
					<li>
						{/* aria-hidden : les initiales ne font que répéter le nom qui suit,
						    les annoncer lettre par lettre serait du bruit au lecteur d'écran. */}
						<span class="avatar" aria-hidden="true">{initiales(membre.nom)}</span>
						<span class="infos">
							<span class="role">{membre.role}</span>
							<span class="name">{membre.nom}</span>
						</span>
					</li>
				))}
			</ul>

			<h3 class="sous-titre">Les autres membres du conseil d'administration</h3>
			<ul class="membres">
				{conseilAdministration.map((nom) => (
					<li>
						<span class="avatar" aria-hidden="true">{initiales(nom)}</span>
						<span class="infos">
							<span class="role">Membre du CA</span>
							<span class="name">{nom}</span>
						</span>
					</li>
				))}
			</ul>
		</section>

		<section class="club-section">
			<h2>Les gymnases</h2>
			{/* Le compte vient de la liste (src/lib/club.ts) : écrit en dur, il mentait
			    dès qu'une salle était ajoutée ou retirée. */}
			<p>Nos entraînements et matchs se déroulent sur {nombreGymnases} installations :</p>
			<div class="gyms-grid">
				{gymnases.map((gymnase) => (
					<article class="gym-card">
						<div class="gym-info">
							<h3>{gymnase.nom}</h3>
							{/* <address> plutôt qu'un <p> : c'est une adresse postale, et le
							    balisage le dit. L'italique par défaut est neutralisé en CSS. */}
							<address class="gym-location">
								{gymnase.rue}<br />
								{gymnase.codePostal} {gymnase.ville}
							</address>
						</div>
					</article>
				))}
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.page-container {
		padding: var(--space-6) var(--space-4);
		max-width: 800px;
		margin: 0 auto;
	}

	.page-header {
		margin-bottom: var(--space-section-y);
		text-align: center;
	}

	/* :global() : l'<img> est rendue par Logo.astro et porte son scope, pas
	   celui de cette page. */
	.page-header :global(.club-blason) {
		display: block;
		margin: 0 auto var(--space-6);
	}

	.page-header h1 {
		margin-bottom: var(--space-4);
		font-size: clamp(2.5rem, 8vw, 4rem);
	}

	.intro {
		font-size: 1.125rem;
		color: var(--color-text-muted);
		max-width: 600px;
		margin: 0 auto;
	}

	.club-section {
		margin-bottom: var(--space-section-y);
	}

	.club-section h2 {
		font-size: clamp(1.75rem, 5vw, 2.5rem);
		margin-bottom: var(--space-6);
	}

	.club-section p {
		margin-bottom: var(--space-4);
	}

	/* Stats */
	.stats-card {
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-8);
		text-align: center;
		margin-top: var(--space-8);
	}

	.stat-number {
		font-size: clamp(4rem, 10vw, 6rem);
		color: var(--color-accent);
		line-height: 1;
		margin-bottom: var(--space-2);
	}

	.stat-label {
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 4vw, 1.75rem);
		font-weight: var(--weight-heading);
		margin-bottom: var(--space-2);
	}

	.stat-note {
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	/* Labels fédéraux — aperçu. Les explications sont sur /labels. */
	.labels-apercu {
		list-style: none;
		padding: 0;
		/* auto-fill + minmax plutôt qu'un nombre de colonnes fixe : sept pastilles
		   ne se répartissent proprement sur aucune grille régulière, et le nombre
		   de labels changera. La largeur minimale suit la pastille de 56px plus
		   les noms longs (« Club Formateur ») sur deux lignes au pire. */
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
		gap: var(--space-6) var(--space-4);
		margin: var(--space-8) 0;
	}

	.labels-apercu li {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		text-align: center;
	}

	/* Pastille claire fixe sous le pictogramme fédéral : son trait cyan est
	   dessiné pour un fond clair et disparaîtrait sur le thème sombre, qui est
	   celui par défaut. Même raisonnement et même valeur que sur /labels —
	   voir src/assets/labels/README.md. */
	.label-pastille {
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: var(--radius-full);
		background-color: #ffffff;
	}

	/* :global() : l'<img> vient de <Image> d'astro:assets, hors du scope. */
	.label-pastille :global(img) {
		width: 38px;
		height: auto;
	}

	.label-nom {
		font-size: 0.875rem;
		color: var(--color-text-muted);
		line-height: 1.3;
	}

	.lien-labels {
		font-weight: var(--weight-body-strong);
	}

	/* Bureau & CA */
	.sous-titre {
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: var(--tracking-eyebrow);
		color: var(--color-text-muted);
		margin: var(--space-6) 0 var(--space-4);
	}

	/* Grille et non flex : en flex, une dernière carte esseulée sur sa ligne
	   s'étire sur toute la largeur (flex: 1) et casse l'alignement. La grille
	   garde des cartes de largeur identique quel que soit le nombre d'éléments.

	   Le bureau et les autres membres du CA partagent exactement la même carte :
	   ce sont des bénévoles de même rang, les distinguer visuellement revenait à
	   hiérarchiser. Seuls les sous-titres séparent les deux groupes. */
	.membres {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}

	.membres li {
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-4);
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: var(--space-4);
	}

	/* Emplacement de la photo du membre. Tant qu'elle n'est pas fournie, il porte
	   les initiales. Le cercle et sa bordure restent identiques une fois l'<img>
	   en place : seul le contenu change. */
	.avatar {
		flex: none;
		width: 48px;
		height: 48px;
		border-radius: var(--radius-full);
		border: 1px solid var(--color-border);
		background-color: var(--color-input-bg);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 0.875rem;
		letter-spacing: 0.04em;
		color: var(--color-text-muted);
		overflow: hidden;
	}

	/* min-width: 0 — sans ça, un nom long refuserait de se couper et déborderait
	   de la carte au lieu de passer à la ligne. */
	.infos {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.membres .role {
		font-size: var(--size-eyebrow);
		text-transform: uppercase;
		letter-spacing: var(--tracking-eyebrow);
		font-weight: var(--weight-body-strong);
		color: var(--color-text-muted);
	}

	.membres .name {
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		font-size: 1.125rem;
		color: var(--color-text);
	}

	/* Gyms Grid */
	.gyms-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-card-gap);
		margin-top: var(--space-6);
	}

	.gym-card {
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-6);
		position: relative;
		overflow: hidden;
		/* Coin griffé (clip-path pour retirer le coin) */
		clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 0 100%);
	}

	/* Ajout de griffures (scratches) en haut à droite avec la couleur accent */
	.gym-card::after {
		content: '';
		position: absolute;
		top: 0;
		right: 12px;
		width: 24px;
		height: 24px;
		background-image: repeating-linear-gradient(
			45deg,
			transparent,
			transparent 2px,
			var(--color-accent) 2px,
			var(--color-accent) 4px
		);
		opacity: 0.8;
	}

	.gym-info h3 {
		font-size: 1.25rem;
		margin-bottom: var(--space-1);
	}

	.gym-location {
		color: var(--color-text-muted);
		font-size: 0.875rem;
		margin: 0;
		/* <address> est en italique par défaut dans les navigateurs — inadapté
		   ici, la balise est choisie pour son sens, pas pour son rendu. */
		font-style: normal;
		line-height: 1.45;
	}

	@media (min-width: 640px) {
		.page-container {
			padding: var(--space-8) var(--space-6);
		}
		
		/* Deux colonnes : le bureau tient en deux lignes de deux cartes. */
		.membres {
			grid-template-columns: repeat(2, 1fr);
		}

		.gyms-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
