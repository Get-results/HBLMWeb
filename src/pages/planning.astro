---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
const contactUrl = baseUrl.endsWith('/') ? `${baseUrl}inscription#contact-form` : `${baseUrl}/inscription#contact-form`;

/* Créneaux transmis par le bureau le 12/09/2026 (visuels officiels du club,
   saison 2026-2027). Regroupés par catégorie et non par jour : un parent
   cherche « quand s'entraîne mon enfant », pas « qui joue le mardi ».

   Les visuels n'indiquent que la commune. Le bureau a confirmé le 13/09/2026
   qu'une commune désigne toujours la même salle : le club ne joue qu'à un
   endroit par ville. D'où la table ci-dessous plutôt que 27 répétitions.

   `gymnase` reste modifiable créneau par créneau : le jour où une catégorie
   s'entraîne ailleurs — la halle Pierre de Coubertin à Lunel-Viel, par exemple,
   qui n'apparaît dans aucun planning actuel — il suffit de le renseigner sur ce
   créneau, la table servant de valeur par défaut.

   `groupe` reprend les mentions des visuels (G1&2, D1, Éq.1...) : ce sont des
   distinctions internes entre équipes d'une même catégorie. */
const gymnaseParCommune: Record<string, string> = {
  Lunel: 'Gymnase Arnassan',
  Marsillargues: 'Gymnase Spinosi',
  Lansargues: 'Gymnase du collège',
};

const filieres = [
  {
    titre: 'École de hand',
    categories: [
      {
        nom: '-7 ans et Baby-hand',
        code: 'U7',
        creneaux: [{ jour: 'Samedi', debut: '9h00', fin: '10h00', commune: 'Lunel', gymnase: null, groupe: null }],
      },
      {
        nom: '-9 ans mixte',
        code: 'U9',
        creneaux: [
          { jour: 'Mercredi', debut: '16h00', fin: '17h30', commune: 'Marsillargues', gymnase: null, groupe: null },
          { jour: 'Samedi', debut: '10h00', fin: '11h30', commune: 'Lunel', gymnase: null, groupe: null },
        ],
      },
    ],
  },
  {
    titre: 'Filière féminine',
    categories: [
      {
        nom: '-11 ans filles',
        code: 'U11',
        creneaux: [
          { jour: 'Mardi', debut: '17h30', fin: '19h00', commune: 'Lunel', gymnase: null, groupe: null },
          { jour: 'Jeudi', debut: '17h30', fin: '19h00', commune: 'Lansargues', gymnase: null, groupe: null },
        ],
      },
      {
        nom: '-13 ans filles',
        code: 'U13',
        creneaux: [
          { jour: 'Lundi', debut: '17h30', fin: '19h00', commune: 'Lunel', gymnase: null, groupe: 'D1' },
          { jour: 'Mercredi', debut: '18h30', fin: '20h00', commune: 'Lansargues', gymnase: null, groupe: 'D1 & D2' },
          { jour: 'Jeudi', debut: '18h00', fin: '19h30', commune: 'Marsillargues', gymnase: null, groupe: 'D2' },
        ],
      },
      {
        nom: '-15 ans filles',
        code: 'U15',
        creneaux: [
          { jour: 'Mercredi', debut: '17h30', fin: '19h00', commune: 'Lunel', gymnase: null, groupe: 'Div. 1' },
          { jour: 'Vendredi', debut: '19h00', fin: '20h30', commune: 'Lansargues', gymnase: null, groupe: 'Div. 1 & 2' },
        ],
      },
      {
        nom: '-18 ans filles',
        code: 'U18',
        creneaux: [
          { jour: 'Mercredi', debut: '19h00', fin: '20h30', commune: 'Marsillargues', gymnase: null, groupe: 'Équipe 1' },
          { jour: 'Jeudi', debut: '19h00', fin: '20h30', commune: 'Lunel', gymnase: null, groupe: 'Équipe 2' },
          { jour: 'Vendredi', debut: '19h00', fin: '20h30', commune: 'Lunel', gymnase: null, groupe: 'Équipe 1' },
        ],
      },
    ],
  },
  {
    titre: 'Filière masculine',
    categories: [
      {
        nom: '-11 ans garçons',
        code: 'U11',
        creneaux: [
          { jour: 'Lundi', debut: '18h00', fin: '19h30', commune: 'Marsillargues', gymnase: null, groupe: null },
          { jour: 'Vendredi', debut: '17h30', fin: '19h00', commune: 'Lunel', gymnase: null, groupe: null },
        ],
      },
      {
        nom: '-13 ans garçons',
        code: 'U13',
        creneaux: [
          { jour: 'Mercredi', debut: '17h30', fin: '19h00', commune: 'Marsillargues', gymnase: null, groupe: 'G1 & G2' },
          { jour: 'Vendredi', debut: '18h30', fin: '20h00', commune: 'Marsillargues', gymnase: null, groupe: 'G1 & G2' },
        ],
      },
      {
        nom: '-15 ans garçons',
        code: 'U15',
        creneaux: [
          { jour: 'Lundi', debut: '19h00', fin: '20h30', commune: 'Lunel', gymnase: null, groupe: 'G1 & G2' },
          { jour: 'Mardi', debut: '17h30', fin: '19h00', commune: 'Lunel', gymnase: null, groupe: null },
          { jour: 'Mercredi', debut: '19h00', fin: '20h30', commune: 'Lunel', gymnase: null, groupe: 'G1' },
          { jour: 'Jeudi', debut: '17h30', fin: '19h00', commune: 'Lunel', gymnase: null, groupe: 'G2' },
        ],
      },
    ],
  },
  {
    titre: 'Séniors',
    categories: [
      {
        nom: 'Séniors filles',
        code: 'SF',
        creneaux: [
          { jour: 'Mercredi', debut: '20h30', fin: '22h30', commune: 'Marsillargues', gymnase: null, groupe: null },
          { jour: 'Vendredi', debut: '20h30', fin: '22h30', commune: 'Lunel', gymnase: null, groupe: null },
        ],
      },
      {
        nom: 'Séniors garçons',
        code: 'SG',
        creneaux: [
          { jour: 'Mardi', debut: '20h30', fin: '22h30', commune: 'Lunel', gymnase: null, groupe: null },
          { jour: 'Jeudi', debut: '20h30', fin: '22h30', commune: 'Lunel', gymnase: null, groupe: null },
        ],
      },
      {
        nom: 'Séniors loisirs',
        code: 'SL',
        creneaux: [
          { jour: 'Lundi', debut: '20h30', fin: '22h30', commune: 'Lunel', gymnase: null, groupe: null },
          { jour: 'Mercredi', debut: '20h30', fin: '22h30', commune: 'Lunel', gymnase: null, groupe: null },
        ],
      },
    ],
  },
];

const saison = '2026-2027';

/* Le créneau l'emporte sur la table ; si ni l'un ni l'autre ne renseigne la
   salle, la page le dit au lieu de laisser un blanc. */
const salleDe = (creneau: { gymnase: string | null; commune: string }) =>
  creneau.gymnase ?? gymnaseParCommune[creneau.commune] ?? null;

const gymnasesIncomplets = filieres.some((f) =>
  f.categories.some((c) => c.creneaux.some((cr) => salleDe(cr) === null)),
);
---

<BaseLayout title="Planning des entraînements | HBLM">
  <div class="page">
    <div class="page-header">
      <p class="eyebrow">HBLM · Handball Lunel-Marsillargues</p>
      <h1 class="page-title">Planning des<br>entraînements<span class="accent-dot">.</span></h1>
      <p class="page-sub">Les créneaux de la saison {saison}, catégorie par catégorie.</p>
    </div>

    {gymnasesIncomplets && (
      <p class="avis-gymnases">
        Les horaires ci-dessous sont ceux de la saison {saison}. Le gymnase exact de
        chaque créneau sera précisé prochainement&nbsp;: seule la commune est indiquée
        pour l'instant. <a href={contactUrl}>Un doute&nbsp;? Contactez le club.</a>
      </p>
    )}

    {filieres.map((filiere) => (
      <section class="filiere">
        <h2 class="filiere-titre">{filiere.titre}</h2>

        <ul class="categories">
          {filiere.categories.map((categorie) => (
            <li class="categorie">
              <h3 class="categorie-nom">
                <span class="categorie-code">{categorie.code}</span>
                {categorie.nom}
              </h3>
              <ul class="creneaux">
                {categorie.creneaux.map((creneau) => (
                  <li class="creneau">
                    <span class="creneau-jour">{creneau.jour}</span>
                    <span class="creneau-heure">{creneau.debut}&nbsp;–&nbsp;{creneau.fin}</span>
                    <span class="creneau-lieu">
                      {salleDe(creneau) ?? 'gymnase à préciser'} · {creneau.commune}
                    </span>
                    {creneau.groupe && <span class="creneau-groupe">{creneau.groupe}</span>}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="rappel">
      Le planning peut évoluer en cours de saison — un doute&nbsp;?
      <a href={contactUrl}>Contactez le club</a>.
    </p>

  </div>
</BaseLayout>

<style>
  .page {
    width: 100%;
    padding: var(--space-section-y) 6vw;
  }

  .page-header {
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: var(--weight-body-strong);
    font-size: var(--size-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 10px 0;
  }

  .page-title {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(34px, 6vw, 64px);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    margin: 0 0 14px 0;
    color: var(--color-text);
    text-transform: uppercase;
  }

  .page-title .accent-dot {
    color: var(--color-accent);
  }

  .page-sub {
    font-size: var(--size-body);
    color: var(--color-text-muted);
    line-height: var(--leading-body);
    margin: 0;
  }

  /* Le planning se lit catégorie par catégorie : un parent cherche son enfant,
     pas son jour de la semaine. Les filières servent de repères visuels. */
  .filiere {
    max-width: 860px;
    margin: 0 auto 48px;
  }

  .filiere-titre {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 22px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 18px;
  }

  .categories,
  .creneaux {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .categories {
    display: grid;
    gap: 14px;
  }

  .categorie {
    padding: 22px 24px 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .categorie-nom {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 18px;
    margin: 0 0 14px;
  }

  .categorie-code {
    flex: none;
    padding: 3px 9px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    /* Texte fixe sur l'accent : l'accent ne change pas entre les thèmes, un
       texte qui suivrait le thème deviendrait illisible en sombre (DESIGN.md). */
    color: #222220;
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .creneaux {
    display: grid;
    gap: 8px;
  }

  .creneau {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-size: 15px;
  }

  .creneau-jour {
    min-width: 5.5em;
    font-weight: var(--weight-body-strong);
  }

  .creneau-heure {
    font-variant-numeric: tabular-nums;
  }

  .creneau-lieu {
    color: var(--color-text-muted);
  }

  .creneau-groupe {
    padding: 2px 8px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .avis-gymnases,
  .rappel {
    max-width: 860px;
    margin: 0 auto 32px;
    padding: 14px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .rappel {
    margin-top: 8px;
    margin-bottom: 0;
  }

  .avis-gymnases a,
  .rappel a {
    color: var(--color-text);
    font-weight: var(--weight-body-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .page { padding: 48px 5vw 64px; }
    .categorie { padding: 20px 18px 22px; }
  }
</style>
