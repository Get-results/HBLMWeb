---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
const contactUrl = baseUrl.endsWith('/') ? `${baseUrl}inscription#contact-form` : `${baseUrl}/inscription#contact-form`;
---

<BaseLayout title="Planning des entraînements | HBLM">
  <div class="page">
    <div class="page-header">
      <p class="eyebrow">HBLM · Handball Lunel-Marsillargues</p>
      <h1 class="page-title">Planning des<br>entraînements<span class="accent-dot">.</span></h1>
      <p class="page-sub">Les créneaux de la semaine, gymnase par gymnase.</p>
    </div>

    <!-- TODO: Remplacer par les vrais créneaux du club -->
    <dl class="planning-list">
      
      <div class="day-row">
        <dt class="day-head">
          <span class="day-name">Lundi</span>
          <span class="day-place">Gymnase <span class="place-name">Arnassan</span> (Lunel)</span>
        </dt>
        <dd class="slot-row">
          <span class="slot"><span class="cat">-15 ans</span> <span class="time">18h–19h30</span></span>
        </dd>
      </div>

      <div class="day-row">
        <dt class="day-head">
          <span class="day-name">Mardi</span>
          <span class="day-place">Gymnase <span class="place-name">Spinosi</span> (Marsillargues)</span>
        </dt>
        <dd class="slot-row">
          <span class="slot"><span class="cat">-13 ans</span> <span class="time">17h30–19h</span></span>
        </dd>
      </div>

      <div class="day-row">
        <dt class="day-head">
          <span class="day-name">Mardi</span>
          <span class="day-place">Gymnase <span class="place-name">Arnassan</span> (Lunel)</span>
        </dt>
        <dd class="slot-row">
          <span class="slot"><span class="cat">-18 ans</span> <span class="time">19h–20h30</span></span>
        </dd>
      </div>

      <div class="day-row">
        <dt class="day-head">
          <span class="day-name">Mardi</span>
          <span class="day-place">Gymnase <span class="place-name">Pierre de Coubertin</span> (Lunel-Viel)</span>
        </dt>
        <dd class="slot-row">
          <span class="slot"><span class="cat">Seniors Compétition</span> <span class="time">20h30–22h</span></span>
        </dd>
      </div>

      <div class="day-row">
        <dt class="day-head">
          <span class="day-name">Mercredi</span>
          <span class="day-place">Gymnase <span class="place-name">Arnassan</span> (Lunel)</span>
        </dt>
        <dd class="slot-row">
          <span class="slot"><span class="cat">Baby-hand (3-5 ans)</span> <span class="time">10h–11h</span></span>
          <span class="slot"><span class="cat">École de hand (6-10 ans)</span> <span class="time">14h–15h30</span></span>
          <span class="slot"><span class="cat">-15 ans</span> <span class="time">18h–19h30</span></span>
        </dd>
      </div>

      <div class="day-row">
        <dt class="day-head">
          <span class="day-name">Jeudi</span>
          <span class="day-place">Gymnase <span class="place-name">Spinosi</span> (Marsillargues)</span>
        </dt>
        <dd class="slot-row">
          <span class="slot"><span class="cat">-13 ans</span> <span class="time">17h30–19h</span></span>
        </dd>
      </div>

      <div class="day-row">
        <dt class="day-head">
          <span class="day-name">Jeudi</span>
          <span class="day-place">Gymnase <span class="place-name">Arnassan</span> (Lunel)</span>
        </dt>
        <dd class="slot-row">
          <span class="slot"><span class="cat">-18 ans</span> <span class="time">19h–20h30</span></span>
        </dd>
      </div>

      <div class="day-row">
        <dt class="day-head">
          <span class="day-name">Jeudi</span>
          <span class="day-place">Gymnase <span class="place-name">Pierre de Coubertin</span> (Lunel-Viel)</span>
        </dt>
        <dd class="slot-row">
          <span class="slot"><span class="cat">Seniors Compétition</span> <span class="time">20h30–22h</span></span>
        </dd>
      </div>

      <div class="day-row">
        <dt class="day-head">
          <span class="day-name">Vendredi</span>
          <span class="day-place">Collège de <span class="place-name">Lansargues</span></span>
        </dt>
        <dd class="slot-row">
          <span class="slot"><span class="cat">Loisir Adultes</span> <span class="time">20h–21h30</span></span>
        </dd>
      </div>

    </dl>

    <div class="info-callout">
      <div class="icon" aria-hidden="true">!</div>
      <p>Le planning peut évoluer en cours de saison — un doute ? <a href={contactUrl}>Contactez le club</a>.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    width: 100%;
    padding: var(--space-section-y) 6vw;
  }

  .page-header {
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: var(--weight-body-strong);
    font-size: var(--size-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 10px 0;
  }

  .page-title {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(34px, 6vw, 64px);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    margin: 0 0 14px 0;
    color: var(--color-text);
    text-transform: uppercase;
  }

  .page-title .accent-dot {
    color: var(--color-accent);
  }

  .page-sub {
    font-size: var(--size-body);
    color: var(--color-text-muted);
    line-height: var(--leading-body);
    margin: 0;
  }

  .planning-list {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0;
  }

  .day-row {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 26px 28px 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - 26px),
      calc(100% - 26px) 100%,
      0 100%
    );
  }

  .day-row::before {
    content: "";
    position: absolute;
    right: 4px;
    bottom: 4px;
    width: 22px;
    height: 22px;
    background:
      linear-gradient(135deg, transparent 47%, var(--color-accent) 47.5%, var(--color-accent) 50%, transparent 50.5%),
      linear-gradient(135deg, transparent 55%, var(--color-accent) 55.5%, var(--color-accent) 58%, transparent 58.5%),
      linear-gradient(135deg, transparent 63%, var(--color-accent) 63.5%, var(--color-accent) 66%, transparent 66.5%);
    pointer-events: none;
    opacity: 0.9;
  }

  .day-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0;
  }

  .day-name {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: 22px;
    color: var(--color-text);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .day-place {
    display: inline-block;
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .day-place .place-name {
    font-weight: var(--weight-body-strong);
    color: var(--color-text);
  }

  .slot-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin: 0;
  }

  .slot {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-body);
    font-weight: var(--weight-body-strong);
    font-size: 13px;
    letter-spacing: 0.01em;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    box-shadow: 0 1px 0 rgba(34,34,32,0.08);
    white-space: nowrap;
  }

  .slot .cat {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: 13px;
  }

  .slot.dark {
    background: var(--color-text);
    color: var(--color-surface);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .slot.dark {
      background: var(--color-border);
      color: var(--color-text);
    }
  }
  :global(:root[data-theme="dark"]) .slot.dark {
    background: var(--color-border);
    color: var(--color-text);
  }

  .slot .time {
    color: inherit;
    opacity: 0.85;
    font-weight: var(--weight-body-strong);
  }

  .info-callout {
    max-width: 900px;
    margin: 40px auto 0;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: 22px 26px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .info-callout .icon {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-on-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: var(--weight-display);
    font-size: 18px;
  }

  .info-callout p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .info-callout a {
    color: var(--color-text);
    font-weight: var(--weight-body-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .page { padding: 48px 5vw 64px; }
    .day-row { padding: 22px 20px 26px; }
    .day-head { flex-direction: column; gap: 4px; }
    .slot-row { gap: 8px; }
    .slot { font-size: 12.5px; padding: 7px 13px; }
    .info-callout { flex-direction: column; align-items: flex-start; text-align: left; }
  }
</style>
