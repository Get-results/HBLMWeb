---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
const contactUrl = baseUrl.endsWith('/') ? `${baseUrl}inscription#contact-form` : `${baseUrl}/inscription#contact-form`;
---

<BaseLayout title="Planning des entraînements | HBLM">
  <div class="page">
    <div class="page-header">
      <p class="eyebrow">HBLM · Handball Lunel-Marsillargues</p>
      <h1 class="page-title">Planning des<br>entraînements<span class="accent-dot">.</span></h1>
      {/* Formulation volontairement neutre : annoncer « les créneaux de la
          semaine » juste au-dessus d'un bloc « en cours de préparation » se
          lit comme une promesse non tenue. À revoir quand le planning
          reviendra. */}
      <p class="page-sub">Les horaires d'entraînement de toutes nos équipes.</p>
    </div>

    {/* Les créneaux réels n'ont pas encore été transmis par le bureau du club.
        Cette page affichait auparavant des exemples fabriqués, publiés tels
        quels — un visiteur pouvait se déplacer sur un horaire inventé.
        En attendant les vrais horaires : aucun créneau affiché.
        Voir A-FAIRE-HORS-CODE.md → « Vrais créneaux d'entraînement ». */}
    <div class="preparation">
      <p class="preparation-title">Planning en cours de préparation</p>
      <p class="preparation-text">
        Les créneaux de la saison sont en cours de finalisation avec les
        entraîneurs et les gymnases. Ils seront publiés ici dès qu'ils seront
        confirmés.
      </p>
      <p class="preparation-text">
        Besoin d'un horaire dès maintenant ? <a href={contactUrl}>Contactez le club</a>,
        nous vous répondrons directement.
      </p>
    </div>

  </div>
</BaseLayout>

<style>
  /* Bloc affiché tant que les créneaux réels ne sont pas transmis. */
  .preparation {
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    text-align: center;
  }

  .preparation-title {
    margin: 0 0 var(--space-4) 0;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.25rem;
  }

  .preparation-text {
    margin: 0 0 var(--space-3) 0;
    color: var(--color-text-muted);
  }

  .preparation-text:last-child {
    margin-bottom: 0;
  }

  .page {
    width: 100%;
    padding: var(--space-section-y) 6vw;
  }

  .page-header {
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: var(--weight-body-strong);
    font-size: var(--size-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 10px 0;
  }

  .page-title {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(34px, 6vw, 64px);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    margin: 0 0 14px 0;
    color: var(--color-text);
    text-transform: uppercase;
  }

  .page-title .accent-dot {
    color: var(--color-accent);
  }

  .page-sub {
    font-size: var(--size-body);
    color: var(--color-text-muted);
    line-height: var(--leading-body);
    margin: 0;
  }

  /* Styles des créneaux — volontairement conservés alors que le balisage
     correspondant est retiré. Ils reviennent tels quels dès que le bureau
     transmet les horaires réels ; les supprimer imposerait de tout réécrire.
     Concerne : .planning-list, .day-row, .day-head, .day-name, .day-place,
     .slot-row, .slot, .info-callout. */
  .planning-list {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0;
  }

  .day-row {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 26px 28px 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - 26px),
      calc(100% - 26px) 100%,
      0 100%
    );
  }

  .day-row::before {
    content: "";
    position: absolute;
    right: 4px;
    bottom: 4px;
    width: 22px;
    height: 22px;
    background:
      linear-gradient(135deg, transparent 47%, var(--color-accent) 47.5%, var(--color-accent) 50%, transparent 50.5%),
      linear-gradient(135deg, transparent 55%, var(--color-accent) 55.5%, var(--color-accent) 58%, transparent 58.5%),
      linear-gradient(135deg, transparent 63%, var(--color-accent) 63.5%, var(--color-accent) 66%, transparent 66.5%);
    pointer-events: none;
    opacity: 0.9;
  }

  .day-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0;
  }

  .day-name {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: 22px;
    color: var(--color-text);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .day-place {
    display: inline-block;
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .day-place .place-name {
    font-weight: var(--weight-body-strong);
    color: var(--color-text);
  }

  .slot-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin: 0;
  }

  .slot {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-body);
    font-weight: var(--weight-body-strong);
    font-size: 13px;
    letter-spacing: 0.01em;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    box-shadow: 0 1px 0 rgba(34,34,32,0.08);
    white-space: nowrap;
  }

  .slot .cat {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: 13px;
  }

  .slot.dark {
    background: var(--color-text);
    color: var(--color-surface);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .slot.dark {
      background: var(--color-border);
      color: var(--color-text);
    }
  }
  :global(:root[data-theme="dark"]) .slot.dark {
    background: var(--color-border);
    color: var(--color-text);
  }

  .slot .time {
    color: inherit;
    opacity: 0.85;
    font-weight: var(--weight-body-strong);
  }

  .info-callout {
    max-width: 900px;
    margin: 40px auto 0;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: 22px 26px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .info-callout .icon {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-on-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: var(--weight-display);
    font-size: 18px;
  }

  .info-callout p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .info-callout a {
    color: var(--color-text);
    font-weight: var(--weight-body-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .page { padding: 48px 5vw 64px; }
    .day-row { padding: 22px 20px 26px; }
    .day-head { flex-direction: column; gap: 4px; }
    .slot-row { gap: 8px; }
    .slot { font-size: 12.5px; padding: 7px 13px; }
    .info-callout { flex-direction: column; align-items: flex-start; text-align: left; }
  }
</style>
