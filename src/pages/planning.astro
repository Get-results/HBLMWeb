---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getCategoriesPubliees,
  formaterAnneesNaissance,
  formaterJour,
  formaterHeures,
} from '../lib/categories';

const baseUrl = import.meta.env.BASE_URL;
const contactUrl = baseUrl.endsWith('/') ? `${baseUrl}inscription#contact-form` : `${baseUrl}/inscription#contact-form`;

/* Une filière n'est qu'un ORDRE D'AFFICHAGE : quelles catégories, dans quel
   ordre, sous quel intertitre. Aucune donnée du club ici — ni horaire, ni
   gymnase, ni groupe. Tout cela vit dans les fiches de `src/content/categories/`,
   d'où cette page les relit.

   Motif : les 27 créneaux existaient en double, ici et dans les fiches, depuis
   que la collection a été créée. Ils étaient identiques au moment de la
   mutualisation — vérifié un par un — mais deux copies d'une donnée officielle
   du bureau ne restent pas longtemps d'accord, et c'est la copie fausse qu'un
   parent lirait avant de se déplacer.

   `code` (U7, U13, SF…) reste ici : c'est un repère visuel propre à cette page,
   pas une donnée du club. */
const filieres = [
  {
    titre: 'École de hand',
    categories: [
      { id: 'baby-hand', code: 'U7' },
      { id: 'ecole-de-hand', code: 'U9' },
    ],
  },
  {
    titre: 'Filière féminine',
    categories: [
      { id: 'moins-de-11-feminines', code: 'U11' },
      { id: 'moins-de-13-feminines', code: 'U13' },
      { id: 'moins-de-15-feminines', code: 'U15' },
      { id: 'moins-de-18-feminines', code: 'U18' },
    ],
  },
  {
    titre: 'Filière masculine',
    categories: [
      { id: 'moins-de-11-masculins', code: 'U11' },
      { id: 'moins-de-13-masculins', code: 'U13' },
      { id: 'moins-de-15-masculins', code: 'U15' },
    ],
  },
  {
    titre: 'Séniors',
    categories: [
      { id: 'seniors-filles', code: 'SF' },
      { id: 'seniors-garcons', code: 'SG' },
      { id: 'seniors-loisirs', code: 'SL' },
    ],
  },
];

const saison = '2026-2027';

/* `getCategoriesPubliees` est le seul point d'entrée autorisé vers la collection :
   il ne rend que les fiches confirmées par le bureau. Une fiche en attente ne
   peut donc pas se retrouver sur cette page, même remplie. */
const fiches = new Map((await getCategoriesPubliees()).map((fiche) => [fiche.id, fiche.data]));

/* Le lien se fait par `id` — le nom du fichier de la fiche — et jamais par le
   libellé affiché : « -7 ans et Baby-hand » contre « -7 ans et baby-hand », un
   rapprochement par texte se serait cassé sur cette seule majuscule sans rien
   dire. Un `id` inconnu CASSE LE BUILD au lieu de vider silencieusement une
   catégorie : une fiche renommée doit se voir tout de suite, pas être découverte
   en ligne par un parent qui ne trouve plus ses horaires. */
const ficheDe = (id: string) => {
  const fiche = fiches.get(id);
  if (!fiche) {
    throw new Error(
      `Planning : la catégorie « ${id} » n'a pas de fiche confirmée dans src/content/categories/.\n` +
        `Fiches disponibles : ${[...fiches.keys()].join(', ')}.`,
    );
  }
  return fiche;
};

/* `venue` porte la salle et la commune en une chaîne — « Gymnase Arnassan
   (Lunel) ». La page les affiche en deux temps, séparés par un point médian.
   Si la forme attendue n'est pas là, on rend la chaîne entière plutôt que d'en
   deviner les morceaux. */
const lieuDe = (venue: string): string => {
  const decoupe = /^(.+?)\s*\(([^)]+)\)\s*$/.exec(venue);
  return decoupe ? `${decoupe[1]} · ${decoupe[2]}` : venue;
};
---

<BaseLayout title="Planning des entraînements | HBLM">
  <div class="page">
    <div class="page-header">
      <p class="eyebrow">HBLM · Handball Lunel-Marsillargues</p>
      <h1 class="page-title">Planning des<br>entraînements<span class="accent-dot">.</span></h1>
      <p class="page-sub">Les créneaux de la saison {saison}, catégorie par catégorie.</p>
    </div>

    {filieres.map((filiere) => (
      <section class="filiere">
        <h2 class="filiere-titre">{filiere.titre}</h2>

        <ul class="categories">
          {filiere.categories.map(({ id, code }) => {
            const fiche = ficheDe(id);
            const annees = formaterAnneesNaissance(fiche);
            return (
              <li class="categorie">
                <h3 class="categorie-nom">
                  <span class="categorie-code">{code}</span>
                  {fiche.label}
                </h3>
                {annees && <p class="categorie-annees">{annees}</p>}
                <ul class="creneaux">
                  {fiche.trainingSlots.map((creneau) => (
                    <li class="creneau">
                      <span class="creneau-jour">{formaterJour(creneau)}</span>
                      <span class="creneau-heure">{formaterHeures(creneau)}</span>
                      <span class="creneau-lieu">{lieuDe(creneau.venue)}</span>
                      {creneau.group && <span class="creneau-groupe">{creneau.group}</span>}
                    </li>
                  ))}
                </ul>
              </li>
            );
          })}
        </ul>
      </section>
    ))}

    <p class="rappel">
      Le planning peut évoluer en cours de saison — un doute&nbsp;?
      <a href={contactUrl}>Contactez le club</a>.
    </p>

  </div>
</BaseLayout>

<style>
  .page {
    width: 100%;
    padding: var(--space-section-y) 6vw;
  }

  .page-header {
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: var(--weight-body-strong);
    font-size: var(--size-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 10px 0;
  }

  .page-title {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(34px, 6vw, 64px);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    margin: 0 0 14px 0;
    color: var(--color-text);
    text-transform: uppercase;
  }

  .page-title .accent-dot {
    color: var(--color-accent);
  }

  .page-sub {
    font-size: var(--size-body);
    color: var(--color-text-muted);
    line-height: var(--leading-body);
    margin: 0;
  }

  /* Le planning se lit catégorie par catégorie : un parent cherche son enfant,
     pas son jour de la semaine. Les filières servent de repères visuels. */
  .filiere {
    max-width: 860px;
    margin: 0 auto 48px;
  }

  .filiere-titre {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 22px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 18px;
  }

  .categories,
  .creneaux {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .categories {
    display: grid;
    gap: 14px;
  }

  .categorie {
    padding: 22px 24px 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .categorie-nom {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 18px;
    margin: 0 0 14px;
  }

  /* Années de naissance : un repère, pas un titre. Elles sont en retrait sous le
     nom de la catégorie, sans capitales ni interlettrage — on les lit une fois
     pour se situer, puis l'œil va aux horaires, qui sont l'objet de la page. */
  .categorie-annees {
    margin: 0 0 var(--space-3);
    font-size: var(--size-eyebrow);
    color: var(--color-text-muted);
  }

  /* Le nom se rapproche de ses années quand il en a : les deux forment un bloc,
     et l'écart utile est celui qui les sépare des créneaux. */
  .categorie-nom:has(+ .categorie-annees) {
    margin-bottom: var(--space-1);
  }

  .categorie-code {
    flex: none;
    padding: 3px 9px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    /* Texte fixe sur l'accent : l'accent ne change pas entre les thèmes, un
       texte qui suivrait le thème deviendrait illisible en sombre (DESIGN.md). */
    color: #222220;
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .creneaux {
    display: grid;
    gap: 8px;
  }

  .creneau {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-size: 15px;
  }

  .creneau-jour {
    min-width: 5.5em;
    font-weight: var(--weight-body-strong);
  }

  .creneau-heure {
    font-variant-numeric: tabular-nums;
  }

  .creneau-lieu {
    color: var(--color-text-muted);
  }

  .creneau-groupe {
    padding: 2px 8px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .rappel {
    max-width: 860px;
    margin: 0 auto 32px;
    padding: 14px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .rappel {
    margin-top: 8px;
    margin-bottom: 0;
  }

  .rappel a {
    color: var(--color-text);
    font-weight: var(--weight-body-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .page { padding: 48px 5vw 64px; }
    .categorie { padding: 20px 18px 22px; }
  }
</style>
