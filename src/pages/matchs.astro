   Remplace le jalon posé quand les liens de navigation pointaient dans le vide.
   Toute la logique vit dans ListeMatchs : la page n'est qu'un cadre. */
import BaseLayout from '../layouts/BaseLayout.astro';
import ListeMatchs from '../components/ListeMatchs.astro';
---

<BaseLayout title="Matchs | HBLM">
  <div class="container">
    <header class="page-header">
      <h1 class="title">Matchs</h1>
      <p class="subtitle">Calendrier et résultats de nos équipes</p>
    </header>

    <section class="content-section">
      <ListeMatchs />
    </section>
  </div>
</BaseLayout>
